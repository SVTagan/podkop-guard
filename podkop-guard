VERSION="0.2.4"

STATE_DIR="${PODKOP_GUARD_DIR:-/etc/podkop-guard}"
LKG_SRS="$STATE_DIR/lkg.srs"
LKG_SUBNETS="$STATE_DIR/lkg-subnets.lst"
CACHE_LKG="$STATE_DIR/cache.db"
CACHE_RUNTIME="/tmp/sing-box/cache.db"
EXPECTED_CACHE_PATH="/tmp/sing-box/cache.db"

RELEASE_BASE="${PODKOP_GUARD_RELEASE_BASE:-https://github.com/itdoginfo/allow-domains/releases/latest/download}"
STARTUP_GRACE="${PODKOP_GUARD_STARTUP_GRACE:-300}"
CHECK_INTERVAL="${PODKOP_GUARD_CHECK_INTERVAL:-3600}"
REFRESH_INTERVAL="${PODKOP_GUARD_REFRESH_INTERVAL:-86400}"
CURL_CONNECT_TIMEOUT="${PODKOP_GUARD_CONNECT_TIMEOUT:-5}"
CURL_MAX_TIME="${PODKOP_GUARD_MAX_TIME:-15}"
NICE_LEVEL="${PODKOP_GUARD_NICE_LEVEL:-10}"
CACHE_TEST_TIMEOUT="${PODKOP_GUARD_CACHE_TEST_TIMEOUT:-10}"

UPDATE_LOCK="/tmp/podkop-guard-update.lock"
UPDATE_WORK=""
SYSLOG_MODE="${PODKOP_GUARD_SYSLOG:-0}"
STOP_REQUESTED=0

log() {
    if [ "$SYSLOG_MODE" = "1" ]; then
        logger -t podkop-guard "$*"
    else
        printf '[podkop-guard] %s\n' "$*"
    fi
}

warn() {
    if [ "$SYSLOG_MODE" = "1" ]; then
        logger -t podkop-guard "warning: $*"
    else
        printf '[podkop-guard] WARNING: %s\n' "$*" >&2
    fi
}

err() {
    if [ "$SYSLOG_MODE" = "1" ]; then
        logger -t podkop-guard "error: $*"
    else
        printf '[podkop-guard] ERROR: %s\n' "$*" >&2
    fi
}

need() {
    command -v "$1" >/dev/null 2>&1 || {
        err "required command not found: $1"
        return 1
    }
}

check_requirements() {
    local cmd
    for cmd in uci curl jq sing-box nice sort cmp date logger mktemp grep tail touch sync; do
        need "$cmd" || return 1
    done
}

run_nice() {
    nice -n "$NICE_LEVEL" "$@"
}

ensure_state_dir() {
    mkdir -p "$STATE_DIR" || {
        err "cannot create $STATE_DIR"
        return 1
    }
}

configured_cache_path() {
    local path
    path="$(uci -q get podkop.settings.cache_path 2>/dev/null)"
    [ -n "$path" ] || path="$EXPECTED_CACHE_PATH"
    printf '%s\n' "$path"
}

community_lists() {
    uci -q get podkop.main.community_lists 2>/dev/null
}

podkop_connection_type() {
    local value
    value="$(uci -q get podkop.main.connection_type 2>/dev/null)"
    [ -n "$value" ] || value="$(uci -q get podkop.main.type 2>/dev/null)"
    printf '%s\n' "$value"
}

validate_tag() {
    case "$1" in
        ''|*[!A-Za-z0-9_.-]*) return 1 ;;
        *) return 0 ;;
    esac
}

runtime_ready() {
    pidof sing-box >/dev/null 2>&1 || return 1
    [ -s "$CACHE_RUNTIME" ] || return 1
    return 0
}

lkg_age() {
    local now mtime

    [ -s "$CACHE_LKG" ] || {
        printf '%s\n' "$REFRESH_INTERVAL"
        return 0
    }

    now="$(date +%s 2>/dev/null)" || return 1
    mtime="$(date -r "$CACHE_LKG" +%s 2>/dev/null)" || return 1

    case "$now:$mtime" in
        *[!0-9:]*|'':*) return 1 ;;
    esac

    if [ "$now" -le "$mtime" ]; then
        printf '0\n'
    else
        printf '%s\n' "$((now - mtime))"
    fi
}

refresh_due() {
    local age
    age="$(lkg_age)" || return 0
    [ "$age" -ge "$REFRESH_INTERVAL" ]
}

acquire_update_lock() {
    local old_pid

    if mkdir "$UPDATE_LOCK" 2>/dev/null; then
        printf '%s\n' "$$" > "$UPDATE_LOCK/pid"
        return 0
    fi

    old_pid="$(cat "$UPDATE_LOCK/pid" 2>/dev/null)"
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        err "another refresh is already running (pid $old_pid)"
        return 1
    fi

    rm -rf "$UPDATE_LOCK"
    if mkdir "$UPDATE_LOCK" 2>/dev/null; then
        printf '%s\n' "$$" > "$UPDATE_LOCK/pid"
        warn "removed stale refresh lock"
        return 0
    fi

    err "cannot acquire refresh lock"
    return 1
}

release_update_lock() {
    rm -rf "$UPDATE_LOCK"
}

cleanup_update() {
    [ -n "$UPDATE_WORK" ] && rm -rf "$UPDATE_WORK"
    UPDATE_WORK=""
    release_update_lock
}

download_srs() {
    local tag output url connection_type interface

    tag="$1"
    output="$2"
    url="$RELEASE_BASE/$tag.srs"

    if curl -4 -fsSL \
        --connect-timeout "$CURL_CONNECT_TIMEOUT" \
        --max-time "$CURL_MAX_TIME" \
        -o "$output" "$url" >/dev/null 2>&1 && [ -s "$output" ]; then
        log "downloaded $tag.srs directly"
        return 0
    fi

    rm -f "$output"
    connection_type="$(podkop_connection_type)"
    interface="$(uci -q get podkop.main.interface 2>/dev/null)"

    if [ "$connection_type" = "vpn" ] && [ -n "$interface" ]; then
        warn "direct download failed for $tag.srs; retrying through $interface"
        if curl -4 -fsSL \
            --interface "$interface" \
            --connect-timeout "$CURL_CONNECT_TIMEOUT" \
            --max-time "$CURL_MAX_TIME" \
            -o "$output" "$url" >/dev/null 2>&1 && [ -s "$output" ]; then
            log "downloaded $tag.srs through $interface"
            return 0
        fi
        rm -f "$output"
    fi

    err "cannot download required Community SRS: $tag"
    return 1
}

validate_srs() {
    local srs json
    srs="$1"
    json="$2"

    if ! run_nice sing-box rule-set decompile --output "$json" "$srs" >/dev/null 2>&1; then
        err "cannot decompile candidate SRS: $srs"
        return 1
    fi

    if ! run_nice jq -e '.version and (.rules | type == "array")' "$json" >/dev/null 2>&1; then
        err "invalid source structure after decompile: $srs"
        return 1
    fi

    return 0
}

build_ruleset_candidate() {
    local lists tag srs json count special_count skipped_cidrs
    local combined canonical roundtrip roundtrip_canonical candidate_srs candidate_subnets

    lists="$(community_lists)"
    [ -n "$lists" ] || {
        err "podkop.main.community_lists is empty"
        return 1
    }

    mkdir -p "$UPDATE_WORK/srs" "$UPDATE_WORK/json" || return 1

    for tag in $lists; do
        validate_tag "$tag" || {
            err "invalid Community List tag: $tag"
            return 1
        }

        srs="$UPDATE_WORK/srs/$tag.srs"
        json="$UPDATE_WORK/json/$tag.json"

        download_srs "$tag" "$srs" || return 1
        validate_srs "$srs" "$json" || return 1
    done

    combined="$UPDATE_WORK/combined.json"
    canonical="$UPDATE_WORK/combined.canonical.json"
    roundtrip="$UPDATE_WORK/roundtrip.json"
    roundtrip_canonical="$UPDATE_WORK/roundtrip.canonical.json"
    candidate_srs="$UPDATE_WORK/lkg.srs"
    candidate_subnets="$UPDATE_WORK/lkg-subnets.lst"

    if ! run_nice jq -s '
        {
          version: ([.[].version] | max),
          rules: [.[].rules[]]
        }
    ' "$UPDATE_WORK"/json/*.json > "$combined"; then
        err "cannot combine Community rule-sets"
        return 1
    fi

    run_nice jq -S . "$combined" > "$canonical" || return 1

    if ! run_nice sing-box rule-set compile --output "$candidate_srs" "$combined" >/dev/null 2>&1; then
        err "cannot compile combined LKG SRS"
        return 1
    fi

    if ! run_nice sing-box rule-set decompile --output "$roundtrip" "$candidate_srs" >/dev/null 2>&1; then
        err "cannot decompile compiled LKG SRS"
        return 1
    fi

    run_nice jq -S . "$roundtrip" > "$roundtrip_canonical" || return 1

    if ! cmp -s "$canonical" "$roundtrip_canonical"; then
        err "LKG SRS round-trip verification failed"
        return 1
    fi

    if ! run_nice jq -r '
        .rules[]?
        | select(((keys_unsorted - ["domain_suffix","ip_cidr"]) | length) == 0)
        | .ip_cidr[]?
    ' "$combined" | sort -u > "$candidate_subnets"; then
        err "cannot derive subnet LKG"
        return 1
    fi

    count="$(wc -l < "$candidate_subnets" | tr -d ' ')"
    special_count="$(run_nice jq '[.rules[]? | select(((keys_unsorted - ["domain_suffix","ip_cidr"]) | length) > 0)] | length' "$combined")"
    skipped_cidrs="$(run_nice jq '[.rules[]? | select(((keys_unsorted - ["domain_suffix","ip_cidr"]) | length) > 0) | .ip_cidr[]?] | length' "$combined")"

    [ "${count:-0}" -gt 0 ] || {
        err "derived subnet candidate is empty; refusing this refresh"
        return 1
    }

    log "candidate LKG passed compile/decompile round-trip; unconditional CIDRs: $count"
    if [ "${special_count:-0}" -gt 0 ]; then
        warn "skipped ${skipped_cidrs:-0} CIDRs from $special_count conditional rule(s)"
    fi

    return 0
}

build_expected_rulesets_json() {
    local output lists
    output="$1"
    lists="$(community_lists)"

    [ -n "$lists" ] || return 1

    printf '%s\n' $lists | run_nice jq -R -s --arg base "$RELEASE_BASE" '
      split("\n")
      | map(select(length > 0))
      | map({
          type: "remote",
          tag: ("main-" + . + "-community-ruleset"),
          format: "binary",
          url: ($base + "/" + . + ".srs"),
          update_interval: "8760h",
          download_detour: "dead"
        })
    ' > "$output"
}

validate_cache_candidate() {
    local candidate test_cache sets_json config log_file pid i

    candidate="$1"
    test_cache="$UPDATE_WORK/cache-test.db"
    sets_json="$UPDATE_WORK/cache-test-rulesets.json"
    config="$UPDATE_WORK/cache-test.json"
    log_file="$UPDATE_WORK/cache-test.log"

    cp "$candidate" "$test_cache" || return 1
    build_expected_rulesets_json "$sets_json" || {
        err "cannot build expected remote rule-set list"
        return 1
    }

    if ! run_nice jq -n \
        --slurpfile sets "$sets_json" \
        --arg cache "$test_cache" '
          ($sets[0]) as $rule_sets
          | {
              log: {level: "info", timestamp: true},
              outbounds: [
                {
                  type: "socks",
                  tag: "dead",
                  server: "127.0.0.1",
                  server_port: 9,
                  version: "5"
                },
                {type: "direct", tag: "direct"}
              ],
              route: {
                rules: [
                  {
                    action: "route",
                    rule_set: ($rule_sets | map(.tag)),
                    outbound: "direct"
                  }
                ],
                rule_set: $rule_sets,
                final: "direct"
              },
              experimental: {
                cache_file: {
                  enabled: true,
                  path: $cache,
                  store_fakeip: false
                }
              }
            }
        ' > "$config"; then
        err "cannot build offline cache validation config"
        return 1
    fi

    if ! run_nice sing-box -c "$config" check >/dev/null 2>&1; then
        err "offline cache validation config is invalid"
        return 1
    fi

    : > "$log_file"
    nice -n "$NICE_LEVEL" sing-box run -c "$config" > "$log_file" 2>&1 &
    pid=$!
    i=0

    while [ "$i" -lt "$CACHE_TEST_TIMEOUT" ]; do
        if grep -q 'sing-box started' "$log_file" 2>/dev/null; then
            kill "$pid" 2>/dev/null
            wait "$pid" 2>/dev/null
            log "candidate cache passed offline cold-start validation"
            return 0
        fi

        if ! kill -0 "$pid" 2>/dev/null; then
            wait "$pid" 2>/dev/null
            err "candidate cache failed offline cold-start validation"
            tail -n 12 "$log_file" 2>/dev/null | while IFS= read -r line; do
                warn "cache-test: $line"
            done
            return 1
        fi

        sleep 1
        i=$((i + 1))
    done

    kill "$pid" 2>/dev/null
    wait "$pid" 2>/dev/null
    err "candidate cache validation timed out after ${CACHE_TEST_TIMEOUT}s"
    tail -n 12 "$log_file" 2>/dev/null | while IFS= read -r line; do
        warn "cache-test: $line"
    done
    return 1
}

build_cache_candidate() {
    local candidate
    candidate="$UPDATE_WORK/cache.db"

    runtime_ready || {
        err "Podkop/sing-box runtime is not ready or runtime cache is missing"
        return 1
    }

    cp "$CACHE_RUNTIME" "$candidate" || {
        err "cannot copy live sing-box cache"
        return 1
    }

    [ -s "$candidate" ] || {
        err "candidate cache is empty"
        return 1
    }

    validate_cache_candidate "$candidate"
}

prepare_persistent_file() {
    local source temp mode
    source="$1"
    temp="$2"
    mode="$3"

    cp "$source" "$temp" || return 1
    chmod "$mode" "$temp" || return 1
}

persist_candidates() {
    local tmp_srs tmp_subnets tmp_cache srs_changed subnets_changed cache_changed

    ensure_state_dir || return 1

    tmp_srs="$STATE_DIR/.lkg.srs.new.$$"
    tmp_subnets="$STATE_DIR/.lkg-subnets.lst.new.$$"
    tmp_cache="$STATE_DIR/.cache.db.new.$$"
    srs_changed=1
    subnets_changed=1
    cache_changed=1

    [ -f "$LKG_SRS" ] && cmp -s "$UPDATE_WORK/lkg.srs" "$LKG_SRS" && srs_changed=0
    [ -f "$LKG_SUBNETS" ] && cmp -s "$UPDATE_WORK/lkg-subnets.lst" "$LKG_SUBNETS" && subnets_changed=0
    [ -f "$CACHE_LKG" ] && cmp -s "$UPDATE_WORK/cache.db" "$CACHE_LKG" && cache_changed=0

    rm -f "$tmp_srs" "$tmp_subnets" "$tmp_cache"

    if [ "$srs_changed" -eq 1 ]; then
        prepare_persistent_file "$UPDATE_WORK/lkg.srs" "$tmp_srs" 0644 || return 1
    fi
    if [ "$subnets_changed" -eq 1 ]; then
        prepare_persistent_file "$UPDATE_WORK/lkg-subnets.lst" "$tmp_subnets" 0644 || return 1
    fi
    if [ "$cache_changed" -eq 1 ]; then
        prepare_persistent_file "$UPDATE_WORK/cache.db" "$tmp_cache" 0600 || return 1
    fi

    sync

    if [ "$srs_changed" -eq 1 ]; then
        mv "$tmp_srs" "$LKG_SRS" || return 1
    fi
    if [ "$subnets_changed" -eq 1 ]; then
        mv "$tmp_subnets" "$LKG_SUBNETS" || return 1
    fi

    # cache.db is committed last and serves as the successful-refresh marker.
    if [ "$cache_changed" -eq 1 ]; then
        mv "$tmp_cache" "$CACHE_LKG" || return 1
    else
        touch "$CACHE_LKG" || return 1
    fi

    chmod 0644 "$LKG_SRS" "$LKG_SUBNETS" 2>/dev/null
    chmod 0600 "$CACHE_LKG" 2>/dev/null
    sync

    log "persistent LKG refresh completed successfully"
    return 0
}

refresh_snapshot_inner() {
    local persist
    persist="$1"

    build_ruleset_candidate || return 1
    build_cache_candidate || return 1

    if [ "$persist" = "1" ]; then
        persist_candidates || {
            err "validated candidates could not be committed"
            return 1
        }
    else
        log "refresh test passed; persistent LKG was not changed"
    fi

    return 0
}

refresh_snapshot() {
    local persist rc
    persist="$1"

    check_requirements || return 1
    acquire_update_lock || return 1

    UPDATE_WORK="/tmp/podkop-guard-update.$$"
    rm -rf "$UPDATE_WORK"
    mkdir -p "$UPDATE_WORK" || {
        release_update_lock
        UPDATE_WORK=""
        return 1
    }

    log "starting validated LKG refresh"
    refresh_snapshot_inner "$persist"
    rc=$?

    if [ "$rc" -ne 0 ]; then
        warn "refresh failed; existing persistent LKG remains in service"
    fi

    cleanup_update
    return "$rc"
}

verify_lkg() {
    local json

    need jq || return 1
    need sing-box || return 1

    [ -s "$LKG_SRS" ] || {
        err "LKG ruleset not found: $LKG_SRS"
        return 1
    }

    json="$(mktemp /tmp/podkop-guard-lkg.XXXXXX)" || return 1

    if ! run_nice sing-box rule-set decompile --output "$json" "$LKG_SRS" >/dev/null 2>&1; then
        rm -f "$json"
        err "cannot decompile $LKG_SRS"
        return 1
    fi

    jq -r '
      "version=" + (.version|tostring),
      "rules=" + (.rules|length|tostring),
      "domains=" + ([.rules[]? | .domain_suffix[]?]|length|tostring),
      "cidrs=" + ([.rules[]? | .ip_cidr[]?]|length|tostring),
      "special_rules=" + ([.rules[]? | select(((keys_unsorted - ["domain_suffix","ip_cidr"])|length) > 0)]|length|tostring)
    ' "$json"

    rm -f "$json"
}

derive_subnets() {
    local json new count special_count skipped_cidrs rc

    need jq || return 1
    need sing-box || return 1
    need sort || return 1
    need cmp || return 1
    ensure_state_dir || return 1

    [ -s "$LKG_SRS" ] || {
        err "LKG ruleset not found: $LKG_SRS"
        return 1
    }

    json="$(mktemp /tmp/podkop-guard-lkg.XXXXXX)" || return 1
    new="$STATE_DIR/.lkg-subnets.lst.new.$$"
    rc=1

    if run_nice sing-box rule-set decompile --output "$json" "$LKG_SRS" >/dev/null 2>&1 &&
       run_nice jq -r '
          .rules[]?
          | select(((keys_unsorted - ["domain_suffix","ip_cidr"])|length) == 0)
          | .ip_cidr[]?
       ' "$json" | sort -u > "$new"; then

        count="$(wc -l < "$new" | tr -d ' ')"
        special_count="$(jq '[.rules[]? | select(((keys_unsorted - ["domain_suffix","ip_cidr"])|length) > 0)] | length' "$json")"
        skipped_cidrs="$(jq '[.rules[]? | select(((keys_unsorted - ["domain_suffix","ip_cidr"])|length) > 0) | .ip_cidr[]?] | length' "$json")"

        if [ -f "$LKG_SUBNETS" ] && cmp -s "$new" "$LKG_SUBNETS"; then
            log "subnet LKG unchanged ($count CIDRs)"
        else
            mv "$new" "$LKG_SUBNETS" && chmod 0644 "$LKG_SUBNETS" &&
                log "updated $LKG_SUBNETS ($count CIDRs)"
        fi

        if [ "${special_count:-0}" -gt 0 ]; then
            warn "skipped ${skipped_cidrs:-0} CIDRs from $special_count conditional rule(s)"
        fi
        rc=0
    else
        err "cannot derive subnet LKG"
    fi

    rm -f "$json" "$new"
    return "$rc"
}

cache_restore() {
    [ -s "$CACHE_LKG" ] || {
        err "persistent cache snapshot not found: $CACHE_LKG"
        return 1
    }

    if pidof sing-box >/dev/null 2>&1; then
        err "sing-box is running; refusing to overwrite its live cache"
        return 1
    fi

    mkdir -p /tmp/sing-box || return 1
    cp "$CACHE_LKG" "$CACHE_RUNTIME" || return 1
    chmod 0600 "$CACHE_RUNTIME"
    log "restored cache snapshot to $CACHE_RUNTIME"
}

boot_restore() {
    local path
    path="$(configured_cache_path)"

    if [ "$path" != "$EXPECTED_CACHE_PATH" ]; then
        warn "boot restore skipped: Podkop cache_path is $path, expected $EXPECTED_CACHE_PATH"
        return 0
    fi

    if [ ! -s "$CACHE_LKG" ]; then
        warn "boot restore skipped: persistent cache snapshot is missing"
        return 0
    fi

    if pidof sing-box >/dev/null 2>&1; then
        log "boot restore skipped: sing-box is already running"
        return 0
    fi

    mkdir -p /tmp/sing-box || {
        err "boot restore failed: cannot create /tmp/sing-box"
        return 1
    }

    cp "$CACHE_LKG" "$CACHE_RUNTIME" || {
        err "boot restore failed: cannot copy persistent cache"
        return 1
    }
    chmod 0600 "$CACHE_RUNTIME"
    log "restored persistent sing-box cache snapshot before Podkop startup"
    return 0
}

wait_seconds() {
    local remaining chunk
    remaining="$1"

    while [ "$remaining" -gt 0 ] && [ "$STOP_REQUESTED" -eq 0 ]; do
        chunk=60
        [ "$remaining" -lt 60 ] && chunk="$remaining"
        sleep "$chunk"
        remaining=$((remaining - chunk))
    done
}

daemon_loop() {
    local age rc

    SYSLOG_MODE=1
    PODKOP_GUARD_SYSLOG=1
    export PODKOP_GUARD_SYSLOG

    check_requirements || return 1

    trap 'STOP_REQUESTED=1' TERM INT
    log "daemon started; startup grace ${STARTUP_GRACE}s, check interval ${CHECK_INTERVAL}s, refresh interval ${REFRESH_INTERVAL}s"

    wait_seconds "$STARTUP_GRACE"

    while [ "$STOP_REQUESTED" -eq 0 ]; do
        if refresh_due; then
            if runtime_ready; then
                age="$(lkg_age 2>/dev/null)"
                log "LKG refresh is due (age ${age:-unknown}s)"
                refresh_snapshot 1
                rc=$?
                if [ "$rc" -ne 0 ]; then
                    warn "validated refresh attempt failed; will retry after ${CHECK_INTERVAL}s"
                fi
            else
                warn "LKG refresh is due, but Podkop/sing-box runtime is not ready; will retry after ${CHECK_INTERVAL}s"
            fi
        fi

        wait_seconds "$CHECK_INTERVAL"
    done

    cleanup_update
    log "daemon stopped"
    return 0
}

status() {
    local age due path lists type

    printf 'podkop-guard %s\n' "$VERSION"
    printf 'state_dir=%s\n' "$STATE_DIR"
    path="$(configured_cache_path)"
    printf 'podkop_cache_path=%s\n' "$path"
    lists="$(community_lists)"
    printf 'community_lists=%s\n' "${lists:-none}"
    type="$(podkop_connection_type)"
    printf 'podkop_main_type=%s\n' "${type:-unknown}"

    if [ -s "$LKG_SRS" ]; then
        printf 'lkg_srs=%s bytes\n' "$(wc -c < "$LKG_SRS" | tr -d ' ')"
    else
        printf 'lkg_srs=missing\n'
    fi

    if [ -f "$LKG_SUBNETS" ]; then
        printf 'lkg_subnets=%s entries\n' "$(wc -l < "$LKG_SUBNETS" | tr -d ' ')"
    else
        printf 'lkg_subnets=missing\n'
    fi

    if [ -s "$CACHE_LKG" ]; then
        printf 'cache_snapshot=%s bytes\n' "$(wc -c < "$CACHE_LKG" | tr -d ' ')"
        age="$(lkg_age 2>/dev/null)"
        printf 'lkg_age_seconds=%s\n' "${age:-unknown}"
        if refresh_due; then due=yes; else due=no; fi
        printf 'refresh_due=%s\n' "$due"
    else
        printf 'cache_snapshot=missing\n'
        printf 'refresh_due=yes\n'
    fi

    if runtime_ready; then
        printf 'podkop_runtime=ready\n'
    else
        printf 'podkop_runtime=not_ready\n'
    fi

    printf 'startup_grace=%s\n' "$STARTUP_GRACE"
    printf 'check_interval=%s\n' "$CHECK_INTERVAL"
    printf 'refresh_interval=%s\n' "$REFRESH_INTERVAL"
}

# Experimental observe-only runtime probe. It never signals a process, modifies
# UCI/nftables or starts/stops Podkop. Three observations are NOT a full end-to-end
# connectivity check: client LAN traffic can differ from router-local probes.
#
# PID lookup adapted from podkop-net/podkop-engine failsafe; see THIRD_PARTY.md.
watch_box_pid() {
    local services
    services=$(ubus -t 5 call service list '{"name":"sing-box"}' 2>/dev/null) || return 2
    [ -n "$services" ] || return 2
    WATCH_PID=$(jsonfilter -s "$services" -e '@["sing-box"]["instances"]["sing-box.main"]["pid"]' 2>/dev/null) || return 2
    WATCH_RUNNING=$(jsonfilter -s "$services" -e '@["sing-box"]["instances"]["sing-box.main"]["running"]' 2>/dev/null) || return 2
    case "$WATCH_PID" in
        ''|*[!0-9]*) WATCH_PID="none"; return 1 ;;
    esac
    [ "$WATCH_RUNNING" = "true" ] || return 1
    return 0
}

watch_nft_table() {
    local tables
    WATCH_NFT="unknown"
    tables=$(nft list tables 2>/dev/null) || return 0
    if printf '%s\n' "$tables" | grep -q '^[[:space:]]*table inet PodkopTable[[:space:]]*$'; then
        WATCH_NFT="present"
    else
        WATCH_NFT="absent"
    fi
}

# Check the answer section, never the nslookup 'Server' banner. This probe is
# entirely local and should not depend on the selected VPN or external DNS.
watch_fakeip() {
    printf '%s\n' "$WATCH_ANSWER" | awk '
        /^Name:[[:space:]]/ { answer = 1; next }
        answer && /^Address:[[:space:]]/ {
            n = split($2, octet, /\./)
            if (n == 4 && octet[1] == 198 &&
                (octet[2] == 18 || octet[2] == 19) &&
                octet[3] ~ /^[0-9]+$/ && octet[4] ~ /^[0-9]+$/ &&
                octet[3] >= 0 && octet[3] <= 255 &&
                octet[4] >= 0 && octet[4] <= 255) found = 1
        }
        END { exit(found ? 0 : 1) }
    '
}

watch_probe_dns() {
    local rc
    WATCH_ANSWER=$(nslookup -timeout=3 -retry=1 -type=A fakeip.podkop.fyi 127.0.0.42 2>&1)
    rc=$?
    if [ "$rc" -eq 0 ] && watch_fakeip; then
        WATCH_DNS="fakeip"
    else
        case "$WATCH_ANSWER" in
            *'timed out'*|*'no servers could be reached'*) WATCH_DNS="timeout" ;;
            *) WATCH_DNS="unconfirmed" ;;
        esac
    fi
}


# Identify actual Podkop jobs, never just a stale list_update.pid.
# These checks suppress a suspected failure; they do not assert health.
watch_maintenance_active() {
    local proc_root list_pid_file pid cmd proc
    proc_root="${PODKOP_GUARD_WATCH_PROC_ROOT:-/proc}"
    list_pid_file="${PODKOP_GUARD_WATCH_LIST_PID_FILE:-/var/run/podkop_list_update.pid}"

    if [ -r "$list_pid_file" ]; then
        read -r pid < "$list_pid_file" || pid=""
        case "$pid" in
            ''|*[!0-9]*) pid="" ;;
        esac
        if [ -n "$pid" ] && [ -r "$proc_root/$pid/cmdline" ]; then
            cmd=$(tr '\000' ' ' < "$proc_root/$pid/cmdline" 2>/dev/null)
            case "$cmd" in
                *'podkop list_update'*) WATCH_MAINTENANCE="list_update"; return 0 ;;
            esac
        fi
    fi

    # Cron/manual list_update may have no PID file.
    for proc in "$proc_root"/[0-9]*/cmdline; do
        [ -r "$proc" ] || continue
        cmd=$(tr '\000' ' ' < "$proc" 2>/dev/null)
        case "$cmd" in
            *'podkop list_update'*) WATCH_MAINTENANCE="list_update"; return 0 ;;
            *'/usr/bin/podkop reload'*|*'/usr/bin/podkop restart'*|*'/usr/bin/podkop start'*|*'/usr/bin/podkop stop'*)
                WATCH_MAINTENANCE="podkop_lifecycle"; return 0 ;;
        esac
    done
    return 1
}

# A nearly-full conntrack table can delay local probes; suppress a definitive
# hang diagnosis if direct evidence of pressure exists.
watch_conntrack_pressure() {
    local base count max
    base="${PODKOP_GUARD_WATCH_CONNTRACK_ROOT:-/proc/sys/net/netfilter}"
    [ -r "$base/nf_conntrack_count" ] && [ -r "$base/nf_conntrack_max" ] || return 1
    read -r count < "$base/nf_conntrack_count" || return 1
    read -r max < "$base/nf_conntrack_max" || return 1
    case "$count:$max" in *[!0-9:]*|:*|*:) return 1 ;; esac
    [ "$max" -gt 0 ] && [ "$count" -ge $((max - max / 20)) ]
}

watchdog_check() {
    local tool shutdown check_pid rc
    WATCH_PID="none"
    WATCH_RUNNING="unknown"
    WATCH_NFT="unknown"
    WATCH_DNS="skipped"
    WATCH_MAINTENANCE=""

    for tool in ubus jsonfilter nft jq nslookup uci awk grep tr; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            printf 'WATCHDOG state=UNKNOWN reason=missing_tool:%s\n' "$tool"
            return 2
        fi
    done

    watch_nft_table
    shutdown=$(uci -q get podkop.settings.shutdown_correctly 2>/dev/null)
    if [ "$shutdown" = "1" ] && [ "$WATCH_NFT" = "absent" ]; then
        printf 'WATCHDOG state=INACTIVE reason=podkop_stopped nft=%s\n' "$WATCH_NFT"
        return 0
    fi

    watch_box_pid
    rc=$?
    if [ "$rc" -eq 2 ]; then
        printf 'WATCHDOG state=UNKNOWN reason=procd_unavailable nft=%s\n' "$WATCH_NFT"
        return 2
    fi
    if [ "$rc" -ne 0 ]; then
        if watch_maintenance_active; then
            printf 'WATCHDOG state=TRANSITION reason=%s pid=none nft=%s\n' "$WATCH_MAINTENANCE" "$WATCH_NFT"
            return 0
        fi
        printf 'WATCHDOG state=SUSPECT_PROCESS_MISSING pid=%s nft=%s\n' "$WATCH_PID" "$WATCH_NFT"
        return 1
    fi

    # This initial probe deliberately supports only the observed Podkop FakeIP
    # inbound. Other DNS layouts must not be declared broken.
    if [ -n "$PODKOP_GUARD_WATCH_CONFIG" ]; then
        check_pid="$PODKOP_GUARD_WATCH_CONFIG"
    else
        check_pid="/etc/sing-box/config.json"
    fi
    if [ ! -r "$check_pid" ] ||
       ! jq -e '.inbounds[]? | select(.tag == "dns-in" and .listen == "127.0.0.42" and .listen_port == 53)' "$check_pid" >/dev/null 2>&1; then
        printf 'WATCHDOG state=UNKNOWN reason=unsupported_dns_config pid=%s nft=%s\n' "$WATCH_PID" "$WATCH_NFT"
        return 2
    fi

    check_pid="$WATCH_PID"
    watch_probe_dns

    # The service might have reloaded while nslookup ran. Re-read the PID to
    # avoid treating a normal transition as failure of the previous process.
    watch_box_pid
    rc=$?
    if [ "$rc" -ne 0 ] || [ "$WATCH_PID" != "$check_pid" ]; then
        printf 'WATCHDOG state=TRANSITION reason=procd_pid_changed nft=%s\n' "$WATCH_NFT"
        return 0
    fi
    if [ "$WATCH_DNS" = "fakeip" ] && [ "$WATCH_NFT" = "present" ]; then
        printf 'WATCHDOG state=HEALTHY_SAMPLED pid=%s dns=fakeip nft=present\n' "$WATCH_PID"
        return 0
    fi
    if [ "$WATCH_DNS" = "timeout" ]; then
        if watch_maintenance_active; then
            printf 'WATCHDOG state=TRANSITION reason=%s pid=%s dns=timeout nft=%s\n' "$WATCH_MAINTENANCE" "$WATCH_PID" "$WATCH_NFT"
            return 0
        fi
        if watch_conntrack_pressure; then
            printf 'WATCHDOG state=UNKNOWN reason=conntrack_pressure pid=%s dns=timeout nft=%s\n' "$WATCH_PID" "$WATCH_NFT"
            return 2
        fi
        printf 'WATCHDOG state=SUSPECT_DNS_TIMEOUT pid=%s dns=timeout nft=%s\n' "$WATCH_PID" "$WATCH_NFT"
        return 1
    fi
    printf 'WATCHDOG state=UNKNOWN pid=%s dns=%s nft=%s\n' "$WATCH_PID" "$WATCH_DNS" "$WATCH_NFT"
    return 2
}


# Bounded RAM-only monitor. This command never signals processes or modifies
# UCI, nftables, service state, cache/LKG or files. "CONFIRMED" means repeated
# local observations, not proof of a root cause or broken Internet.
watch_monitor_number() {
    case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac
}

watch_monitor_now() {
    local whole rest
    [ -r "$WATCH_MONITOR_UPTIME_FILE" ] || return 1
    read -r whole rest < "$WATCH_MONITOR_UPTIME_FILE" || return 1
    whole=${whole%%.*}
    watch_monitor_number "$whole" || return 1
    WATCH_MONITOR_NOW=$whole
}

watchdog_monitor() {
    local cycles interval threshold grace check_script sample_output sample_rc
    local sample_no state payload pid rest now armed_pid last_pid hold_until
    local missing_active streak streak_kind phase confirmations startup_deadline
    local stopped

    [ "$#" -le 2 ] || {
        err "usage: podkop-guard watchdog-monitor [cycles 1..30] [interval_seconds 0..300]"
        return 2
    }
    cycles="${1:-6}"
    interval="${2:-20}"
    threshold="${PODKOP_GUARD_WATCH_THRESHOLD:-3}"
    grace="${PODKOP_GUARD_WATCH_GRACE:-180}"
    WATCH_MONITOR_UPTIME_FILE="${PODKOP_GUARD_WATCH_UPTIME_FILE:-/proc/uptime}"
    check_script="${PODKOP_GUARD_WATCH_CHECK_SCRIPT:-$0}"

    for payload in "$cycles" "$interval" "$threshold" "$grace"; do
        watch_monitor_number "$payload" || { err "invalid monitor numeric argument"; return 2; }
    done
    [ "$cycles" -ge 1 ] && [ "$cycles" -le 30 ] &&
    [ "$interval" -ge 0 ] && [ "$interval" -le 300 ] &&
    [ "$threshold" -ge 2 ] && [ "$threshold" -le 10 ] &&
    [ "$grace" -ge 0 ] && [ "$grace" -le 600 ] || {
        err "monitor limits: cycles=1..30 interval=0..300 threshold=2..10 grace=0..600"
        return 2
    }
    [ -r "$check_script" ] || { err "monitor check script is not readable"; return 2; }
    watch_monitor_now || { err "cannot read monotonic /proc/uptime"; return 2; }

    startup_deadline=$((WATCH_MONITOR_NOW + grace))
    hold_until=$startup_deadline
    armed_pid=""
    last_pid=""
    missing_active=0
    streak=0
    streak_kind=""
    confirmations=0
    stopped=0
    trap 'stopped=1' TERM INT

    printf 'MONITOR mode=observe-only cycles=%s interval=%ss threshold=%s grace=%ss\n' \
        "$cycles" "$interval" "$threshold" "$grace"
    sample_no=1
    while [ "$sample_no" -le "$cycles" ] && [ "$stopped" -eq 0 ]; do
        if ! watch_monitor_now; then
            printf 'MONITOR sample=%s/%s state=UNKNOWN phase=UNKNOWN reason=uptime_unavailable\n' \
                "$sample_no" "$cycles"
            streak=0
            streak_kind=""
            sample_no=$((sample_no + 1))
            [ "$sample_no" -le "$cycles" ] && [ "$interval" -gt 0 ] && sleep "$interval"
            continue
        fi
        now=$WATCH_MONITOR_NOW
        sample_output=$(sh "$check_script" watchdog-check 2>&1)
        sample_rc=$?
        state=UNKNOWN
        pid=none
        case "$sample_output" in
            'WATCHDOG state='*)
                payload=${sample_output#WATCHDOG state=}
                state=${payload%% *}
                case " $sample_output " in
                    *' pid='*)
                        rest=${sample_output#* pid=}
                        pid=${rest%% *}
                        ;;
                esac
                ;;
        esac
        case "$state:$sample_rc" in
            HEALTHY_SAMPLED:0|INACTIVE:0|TRANSITION:0|SUSPECT_DNS_TIMEOUT:1|SUSPECT_PROCESS_MISSING:1|UNKNOWN:2) ;;
            *) state=UNKNOWN ;;
        esac
        case "$state" in
            HEALTHY_SAMPLED|SUSPECT_DNS_TIMEOUT)
                if ! watch_monitor_number "$pid"; then state=UNKNOWN; fi
                ;;
        esac

        # A changed procd PID invalidates previously armed DNS results.
        if watch_monitor_number "$pid"; then
            if [ -n "$last_pid" ] && [ "$last_pid" != "$pid" ]; then
                armed_pid=""
                hold_until=$((now + grace))
                streak=0
                streak_kind=""
            fi
            last_pid=$pid
        fi

        phase=UNKNOWN
        case "$state" in
            HEALTHY_SAMPLED)
                armed_pid=$pid
                missing_active=0
                streak=0
                streak_kind=""
                phase=HEALTHY
                ;;
            INACTIVE)
                armed_pid=""
                last_pid=""
                missing_active=0
                streak=0
                streak_kind=""
                phase=INACTIVE
                ;;
            TRANSITION)
                armed_pid=""
                missing_active=0
                streak=0
                streak_kind=""
                hold_until=$((now + grace))
                phase=TRANSITION
                ;;
            UNKNOWN)
                streak=0
                streak_kind=""
                phase=UNKNOWN
                ;;
            SUSPECT_PROCESS_MISSING|SUSPECT_DNS_TIMEOUT)
                if [ "$state" = SUSPECT_PROCESS_MISSING ]; then
                    if [ "$missing_active" -eq 0 ]; then
                        hold_until=$((now + grace))
                        missing_active=1
                    fi
                else
                    missing_active=0
                fi
                if [ "$now" -lt "$startup_deadline" ] && [ -z "$armed_pid" ]; then
                    streak=0
                    streak_kind=""
                    phase=STARTUP_GRACE
                elif [ "$now" -lt "$hold_until" ]; then
                    streak=0
                    streak_kind=""
                    phase=TRANSITION_GRACE
                elif [ "$state" = SUSPECT_DNS_TIMEOUT ] && [ "$armed_pid" != "$pid" ]; then
                    streak=0
                    streak_kind=""
                    phase=WAITING_FOR_BASELINE
                else
                    if [ "$streak_kind" != "$state" ]; then
                        streak=0
                        streak_kind=$state
                    fi
                    streak=$((streak + 1))
                    if [ "$streak" -ge "$threshold" ]; then
                        phase=CONFIRMED
                        if [ "$streak" -eq "$threshold" ]; then
                            confirmations=$((confirmations + 1))
                            printf 'MONITOR_EVENT confirmed=%s state=%s pid=%s samples=%s action=none\n' \
                                "$confirmations" "$state" "$pid" "$streak"
                        fi
                    else
                        phase=SUSPECT
                    fi
                fi
                ;;
        esac
        printf 'MONITOR sample=%s/%s state=%s phase=%s pid=%s streak=%s\n' \
            "$sample_no" "$cycles" "$state" "$phase" "$pid" "$streak"
        if [ "$sample_no" -lt "$cycles" ] && [ "$interval" -gt 0 ]; then
            sleep "$interval"
        fi
        sample_no=$((sample_no + 1))
    done
    trap - TERM INT
    printf 'MONITOR_END completed=%s confirmations=%s action=none\n' \
        "$((sample_no - 1))" "$confirmations"
    return 0
}


usage() {
    cat <<'EOF'
Usage: podkop-guard <command>

Commands:
  status          Show current guard/LKG state
  verify-lkg      Inspect the persistent LKG SRS
  derive-subnets  Rebuild Local Subnet LKG from persistent lkg.srs
  refresh-test    Build and fully validate new candidates without saving them
  refresh         Build, validate and atomically commit a new persistent LKG
  cache-restore   Manually restore cache while sing-box is stopped
  boot-restore    Safe boot-time cache restore (skips when not applicable)
  watchdog-check  One-shot observe-only sing-box/Podkop runtime sample
  watchdog-monitor [cycles] [interval]  Bounded RAM-only observer (default 6 x 20s)
  daemon          Run the periodic validated refresh worker
  version         Print version

The periodic worker checks once per hour and refreshes no more than once per
24 hours after a successful snapshot. Failed refreshes never replace the
current persistent LKG and are retried on the next hourly check.
EOF
}

case "${1:-}" in
    status) status ;;
    verify-lkg) verify_lkg ;;
    derive-subnets) derive_subnets ;;
    refresh-test) refresh_snapshot 0 ;;
    refresh) refresh_snapshot 1 ;;
    cache-restore) cache_restore ;;
    boot-restore) boot_restore ;;
    watchdog-check) watchdog_check ;;
    watchdog-monitor) shift; watchdog_monitor "$@" ;;
    daemon) daemon_loop ;;
    version|--version|-V) echo "$VERSION" ;;
    help|--help|-h|'') usage ;;
    *) err "unknown command: $1"; usage >&2; exit 2 ;;
esac
