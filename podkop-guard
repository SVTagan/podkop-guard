VERSION="0.3.0-dev"

STATE_DIR="${PODKOP_GUARD_DIR:-/etc/podkop-guard}"
LKG_SRS="$STATE_DIR/lkg.srs"
LKG_SUBNETS="$STATE_DIR/lkg-subnets.lst"
CACHE_LKG="$STATE_DIR/cache.db"
CACHE_RUNTIME="/tmp/sing-box/cache.db"
EXPECTED_CACHE_PATH="/tmp/sing-box/cache.db"

RELEASE_BASE="${PODKOP_GUARD_RELEASE_BASE:-https://github.com/itdoginfo/allow-domains/releases/latest/download}"
STARTUP_GRACE="${PODKOP_GUARD_STARTUP_GRACE:-300}"
CHECK_INTERVAL="${PODKOP_GUARD_CHECK_INTERVAL:-3600}"
REFRESH_INTERVAL="${PODKOP_GUARD_REFRESH_INTERVAL:-86400}"
CURL_CONNECT_TIMEOUT="${PODKOP_GUARD_CONNECT_TIMEOUT:-5}"
CURL_MAX_TIME="${PODKOP_GUARD_MAX_TIME:-15}"
NICE_LEVEL="${PODKOP_GUARD_NICE_LEVEL:-10}"
CACHE_TEST_TIMEOUT="${PODKOP_GUARD_CACHE_TEST_TIMEOUT:-10}"

UPDATE_LOCK="/tmp/podkop-guard-update.lock"
UPDATE_WORK=""
SYSLOG_MODE="${PODKOP_GUARD_SYSLOG:-0}"
STOP_REQUESTED=0

log() {
    if [ "$SYSLOG_MODE" = "1" ]; then
        logger -t podkop-guard "$*"
    else
        printf '[podkop-guard] %s\n' "$*"
    fi
}

warn() {
    if [ "$SYSLOG_MODE" = "1" ]; then
        logger -t podkop-guard "warning: $*"
    else
        printf '[podkop-guard] WARNING: %s\n' "$*" >&2
    fi
}

err() {
    if [ "$SYSLOG_MODE" = "1" ]; then
        logger -t podkop-guard "error: $*"
    else
        printf '[podkop-guard] ERROR: %s\n' "$*" >&2
    fi
}

need() {
    command -v "$1" >/dev/null 2>&1 || {
        err "required command not found: $1"
        return 1
    }
}

check_requirements() {
    local cmd
    for cmd in uci curl jq sing-box nice sort cmp date logger mktemp grep tail touch sync; do
        need "$cmd" || return 1
    done
}

run_nice() {
    nice -n "$NICE_LEVEL" "$@"
}

ensure_state_dir() {
    mkdir -p "$STATE_DIR" || {
        err "cannot create $STATE_DIR"
        return 1
    }
}

configured_cache_path() {
    local path
    path="$(uci -q get podkop.settings.cache_path 2>/dev/null)"
    [ -n "$path" ] || path="$EXPECTED_CACHE_PATH"
    printf '%s\n' "$path"
}

community_lists() {
    uci -q get podkop.main.community_lists 2>/dev/null
}

podkop_connection_type() {
    local value
    value="$(uci -q get podkop.main.connection_type 2>/dev/null)"
    [ -n "$value" ] || value="$(uci -q get podkop.main.type 2>/dev/null)"
    printf '%s\n' "$value"
}

validate_tag() {
    case "$1" in
        ''|*[!A-Za-z0-9_.-]*) return 1 ;;
        *) return 0 ;;
    esac
}

runtime_ready() {
    pidof sing-box >/dev/null 2>&1 || return 1
    [ -s "$CACHE_RUNTIME" ] || return 1
    return 0
}

lkg_age() {
    local now mtime

    [ -s "$CACHE_LKG" ] || {
        printf '%s\n' "$REFRESH_INTERVAL"
        return 0
    }

    now="$(date +%s 2>/dev/null)" || return 1
    mtime="$(date -r "$CACHE_LKG" +%s 2>/dev/null)" || return 1

    case "$now:$mtime" in
        *[!0-9:]*|'':*) return 1 ;;
    esac

    if [ "$now" -le "$mtime" ]; then
        printf '0\n'
    else
        printf '%s\n' "$((now - mtime))"
    fi
}

refresh_due() {
    local age
    age="$(lkg_age)" || return 0
    [ "$age" -ge "$REFRESH_INTERVAL" ]
}

acquire_update_lock() {
    local old_pid

    if mkdir "$UPDATE_LOCK" 2>/dev/null; then
        printf '%s\n' "$$" > "$UPDATE_LOCK/pid"
        return 0
    fi

    old_pid="$(cat "$UPDATE_LOCK/pid" 2>/dev/null)"
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        err "another refresh is already running (pid $old_pid)"
        return 1
    fi

    rm -rf "$UPDATE_LOCK"
    if mkdir "$UPDATE_LOCK" 2>/dev/null; then
        printf '%s\n' "$$" > "$UPDATE_LOCK/pid"
        warn "removed stale refresh lock"
        return 0
    fi

    err "cannot acquire refresh lock"
    return 1
}

release_update_lock() {
    rm -rf "$UPDATE_LOCK"
}

cleanup_update() {
    [ -n "$UPDATE_WORK" ] && rm -rf "$UPDATE_WORK"
    UPDATE_WORK=""
    release_update_lock
}

download_srs() {
    local tag output url connection_type interface

    tag="$1"
    output="$2"
    url="$RELEASE_BASE/$tag.srs"

    if curl -4 -fsSL \
        --connect-timeout "$CURL_CONNECT_TIMEOUT" \
        --max-time "$CURL_MAX_TIME" \
        -o "$output" "$url" >/dev/null 2>&1 && [ -s "$output" ]; then
        log "downloaded $tag.srs directly"
        return 0
    fi

    rm -f "$output"
    connection_type="$(podkop_connection_type)"
    interface="$(uci -q get podkop.main.interface 2>/dev/null)"

    if [ "$connection_type" = "vpn" ] && [ -n "$interface" ]; then
        warn "direct download failed for $tag.srs; retrying through $interface"
        if curl -4 -fsSL \
            --interface "$interface" \
            --connect-timeout "$CURL_CONNECT_TIMEOUT" \
            --max-time "$CURL_MAX_TIME" \
            -o "$output" "$url" >/dev/null 2>&1 && [ -s "$output" ]; then
            log "downloaded $tag.srs through $interface"
            return 0
        fi
        rm -f "$output"
    fi

    err "cannot download required Community SRS: $tag"
    return 1
}

validate_srs() {
    local srs json
    srs="$1"
    json="$2"

    if ! run_nice sing-box rule-set decompile --output "$json" "$srs" >/dev/null 2>&1; then
        err "cannot decompile candidate SRS: $srs"
        return 1
    fi

    if ! run_nice jq -e '.version and (.rules | type == "array")' "$json" >/dev/null 2>&1; then
        err "invalid source structure after decompile: $srs"
        return 1
    fi

    return 0
}


# sing-box can decompile singleton domain_suffix/ip_cidr values as strings,
# and lower binary rule-set version to the lowest required version.
# Compare known rule semantics, not JSON formatting or version numbering.
ruleset_canonicalize() {
    local input="$1" output="$2"
    run_nice jq -S '
      def as_list: (if type == "array" then . else [.] end) | unique;
      del(.version)
      | walk(
          if type == "object" then
            with_entries(
              if (.key == "domain_suffix" or .key == "ip_cidr") and .value != null
              then .value |= as_list
              else . end
            )
          else . end
        )
    ' "$input" > "$output"
}

# In sing-box default rules domain_suffix and ip_cidr belong to the same
# OR group. Extract CIDRs if no other (AND-group) conditions are present.
ruleset_extract_plain_cidrs() {
    run_nice jq -r '
      def items: if type == "array" then .[] else . end;
      .rules[]?
      | select(
          (.type // "default") == "default" and
          .ip_cidr != null and
          ((keys_unsorted - ["type","domain_suffix","ip_cidr"]) | length) == 0
        )
      | .ip_cidr | items
    ' "$1"
}

ruleset_conditional_metrics() {
    run_nice jq -r '
      def items: if type == "array" then .[] else . end;
      def plain:
        (.type // "default") == "default" and
        .ip_cidr != null and
        ((keys_unsorted - ["type","domain_suffix","ip_cidr"]) | length) == 0;
      [.rules[]? | select(.ip_cidr != null and (plain | not))] as $bad
      | "\($bad | length) \([$bad[] | .ip_cidr | items] | length)"
    ' "$1"
}

build_ruleset_candidate() {
    local lists tag srs json count special_count skipped_cidrs
    local combined canonical roundtrip roundtrip_canonical candidate_srs candidate_subnets

    lists="$(community_lists)"
    [ -n "$lists" ] || {
        err "podkop.main.community_lists is empty"
        return 1
    }

    mkdir -p "$UPDATE_WORK/srs" "$UPDATE_WORK/json" || return 1

    for tag in $lists; do
        validate_tag "$tag" || {
            err "invalid Community List tag: $tag"
            return 1
        }

        srs="$UPDATE_WORK/srs/$tag.srs"
        json="$UPDATE_WORK/json/$tag.json"

        download_srs "$tag" "$srs" || return 1
        validate_srs "$srs" "$json" || return 1
    done

    combined="$UPDATE_WORK/combined.json"
    canonical="$UPDATE_WORK/combined.canonical.json"
    roundtrip="$UPDATE_WORK/roundtrip.json"
    roundtrip_canonical="$UPDATE_WORK/roundtrip.canonical.json"
    candidate_srs="$UPDATE_WORK/lkg.srs"
    candidate_subnets="$UPDATE_WORK/lkg-subnets.lst"

    if ! run_nice jq -s '
        {
          version: ([.[].version] | max),
          rules: [.[].rules[]]
        }
    ' "$UPDATE_WORK"/json/*.json > "$combined"; then
        err "cannot combine Community rule-sets"
        return 1
    fi

    ruleset_canonicalize "$combined" "$canonical" || return 1

    if ! run_nice sing-box rule-set compile --output "$candidate_srs" "$combined" >/dev/null 2>&1; then
        err "cannot compile combined LKG SRS"
        return 1
    fi

    if ! run_nice sing-box rule-set decompile --output "$roundtrip" "$candidate_srs" >/dev/null 2>&1; then
        err "cannot decompile compiled LKG SRS"
        return 1
    fi

    if ! run_nice jq -e '
        (.version | type == "number") and (.version >= 1) and
        (.rules | type == "array")
    ' "$roundtrip" >/dev/null 2>&1; then
        err "invalid compiled rule-set after round-trip"
        return 1
    fi
    ruleset_canonicalize "$roundtrip" "$roundtrip_canonical" || return 1

    if ! cmp -s "$canonical" "$roundtrip_canonical"; then
        err "LKG SRS round-trip verification failed"
        return 1
    fi

    if ! ruleset_extract_plain_cidrs "$combined" | sort -u > "$candidate_subnets"; then
        err "cannot derive subnet LKG"
        return 1
    fi

    count="$(wc -l < "$candidate_subnets" | tr -d ' ')"
    local metrics
    metrics="$(ruleset_conditional_metrics "$combined")" || return 1
    special_count="${metrics%% *}"
    skipped_cidrs="${metrics#* }"

    [ "${count:-0}" -gt 0 ] || {
        err "derived subnet candidate is empty; refusing this refresh"
        return 1
    }

    log "candidate LKG passed compile/decompile round-trip; unconditional CIDRs: $count"
    if [ "${special_count:-0}" -gt 0 ]; then
        warn "skipped ${skipped_cidrs:-0} CIDRs from $special_count conditional rule(s)"
    fi

    return 0
}

build_expected_rulesets_json() {
    local output lists
    output="$1"
    lists="$(community_lists)"

    [ -n "$lists" ] || return 1

    printf '%s\n' $lists | run_nice jq -R -s --arg base "$RELEASE_BASE" '
      split("\n")
      | map(select(length > 0))
      | map({
          type: "remote",
          tag: ("main-" + . + "-community-ruleset"),
          format: "binary",
          url: ($base + "/" + . + ".srs"),
          update_interval: "8760h",
          download_detour: "dead"
        })
    ' > "$output"
}

validate_cache_candidate() {
    local candidate test_cache sets_json config log_file pid i

    candidate="$1"
    test_cache="$UPDATE_WORK/cache-test.db"
    sets_json="$UPDATE_WORK/cache-test-rulesets.json"
    config="$UPDATE_WORK/cache-test.json"
    log_file="$UPDATE_WORK/cache-test.log"

    cp "$candidate" "$test_cache" || return 1
    build_expected_rulesets_json "$sets_json" || {
        err "cannot build expected remote rule-set list"
        return 1
    }

    if ! run_nice jq -n \
        --slurpfile sets "$sets_json" \
        --arg cache "$test_cache" '
          ($sets[0]) as $rule_sets
          | {
              log: {level: "info", timestamp: true},
              outbounds: [
                {
                  type: "socks",
                  tag: "dead",
                  server: "127.0.0.1",
                  server_port: 9,
                  version: "5"
                },
                {type: "direct", tag: "direct"}
              ],
              route: {
                rules: [
                  {
                    action: "route",
                    rule_set: ($rule_sets | map(.tag)),
                    outbound: "direct"
                  }
                ],
                rule_set: $rule_sets,
                final: "direct"
              },
              experimental: {
                cache_file: {
                  enabled: true,
                  path: $cache,
                  store_fakeip: false
                }
              }
            }
        ' > "$config"; then
        err "cannot build offline cache validation config"
        return 1
    fi

    if ! run_nice sing-box -c "$config" check >/dev/null 2>&1; then
        err "offline cache validation config is invalid"
        return 1
    fi

    : > "$log_file"
    nice -n "$NICE_LEVEL" sing-box run -c "$config" > "$log_file" 2>&1 &
    pid=$!
    i=0

    while [ "$i" -lt "$CACHE_TEST_TIMEOUT" ]; do
        if grep -q 'sing-box started' "$log_file" 2>/dev/null; then
            kill "$pid" 2>/dev/null
            wait "$pid" 2>/dev/null
            log "candidate cache passed offline cold-start validation"
            return 0
        fi

        if ! kill -0 "$pid" 2>/dev/null; then
            wait "$pid" 2>/dev/null
            err "candidate cache failed offline cold-start validation"
            tail -n 12 "$log_file" 2>/dev/null | while IFS= read -r line; do
                warn "cache-test: $line"
            done
            return 1
        fi

        sleep 1
        i=$((i + 1))
    done

    kill "$pid" 2>/dev/null
    wait "$pid" 2>/dev/null
    err "candidate cache validation timed out after ${CACHE_TEST_TIMEOUT}s"
    tail -n 12 "$log_file" 2>/dev/null | while IFS= read -r line; do
        warn "cache-test: $line"
    done
    return 1
}

build_cache_candidate() {
    local candidate
    candidate="$UPDATE_WORK/cache.db"

    runtime_ready || {
        err "Podkop/sing-box runtime is not ready or runtime cache is missing"
        return 1
    }

    cp "$CACHE_RUNTIME" "$candidate" || {
        err "cannot copy live sing-box cache"
        return 1
    }

    [ -s "$candidate" ] || {
        err "candidate cache is empty"
        return 1
    }

    validate_cache_candidate "$candidate"
}

prepare_persistent_file() {
    local source temp mode
    source="$1"
    temp="$2"
    mode="$3"

    cp "$source" "$temp" || return 1
    chmod "$mode" "$temp" || return 1
}

persist_candidates() {
    local tmp_srs tmp_subnets tmp_cache srs_changed subnets_changed cache_changed

    ensure_state_dir || return 1

    tmp_srs="$STATE_DIR/.lkg.srs.new.$$"
    tmp_subnets="$STATE_DIR/.lkg-subnets.lst.new.$$"
    tmp_cache="$STATE_DIR/.cache.db.new.$$"
    srs_changed=1
    subnets_changed=1
    cache_changed=1

    [ -f "$LKG_SRS" ] && cmp -s "$UPDATE_WORK/lkg.srs" "$LKG_SRS" && srs_changed=0
    [ -f "$LKG_SUBNETS" ] && cmp -s "$UPDATE_WORK/lkg-subnets.lst" "$LKG_SUBNETS" && subnets_changed=0
    [ -f "$CACHE_LKG" ] && cmp -s "$UPDATE_WORK/cache.db" "$CACHE_LKG" && cache_changed=0

    rm -f "$tmp_srs" "$tmp_subnets" "$tmp_cache"

    if [ "$srs_changed" -eq 1 ]; then
        prepare_persistent_file "$UPDATE_WORK/lkg.srs" "$tmp_srs" 0644 || return 1
    fi
    if [ "$subnets_changed" -eq 1 ]; then
        prepare_persistent_file "$UPDATE_WORK/lkg-subnets.lst" "$tmp_subnets" 0644 || return 1
    fi
    if [ "$cache_changed" -eq 1 ]; then
        prepare_persistent_file "$UPDATE_WORK/cache.db" "$tmp_cache" 0600 || return 1
    fi

    sync

    if [ "$srs_changed" -eq 1 ]; then
        mv "$tmp_srs" "$LKG_SRS" || return 1
    fi
    if [ "$subnets_changed" -eq 1 ]; then
        mv "$tmp_subnets" "$LKG_SUBNETS" || return 1
    fi

    # cache.db is committed last and serves as the successful-refresh marker.
    if [ "$cache_changed" -eq 1 ]; then
        mv "$tmp_cache" "$CACHE_LKG" || return 1
    else
        touch "$CACHE_LKG" || return 1
    fi

    chmod 0644 "$LKG_SRS" "$LKG_SUBNETS" 2>/dev/null
    chmod 0600 "$CACHE_LKG" 2>/dev/null
    sync

    log "persistent LKG refresh completed successfully"
    return 0
}

refresh_snapshot_inner() {
    local persist
    persist="$1"

    build_ruleset_candidate || return 1
    build_cache_candidate || return 1

    if [ "$persist" = "1" ]; then
        persist_candidates || {
            err "validated candidates could not be committed"
            return 1
        }
    else
        log "refresh test passed; persistent LKG was not changed"
    fi

    return 0
}

refresh_snapshot() {
    local persist rc
    persist="$1"

    check_requirements || return 1
    acquire_update_lock || return 1

    UPDATE_WORK="/tmp/podkop-guard-update.$$"
    rm -rf "$UPDATE_WORK"
    mkdir -p "$UPDATE_WORK" || {
        release_update_lock
        UPDATE_WORK=""
        return 1
    }

    log "starting validated LKG refresh"
    refresh_snapshot_inner "$persist"
    rc=$?

    if [ "$rc" -ne 0 ]; then
        warn "refresh failed; existing persistent LKG remains in service"
    fi

    cleanup_update
    return "$rc"
}

verify_lkg() {
    local json

    need jq || return 1
    need sing-box || return 1

    [ -s "$LKG_SRS" ] || {
        err "LKG ruleset not found: $LKG_SRS"
        return 1
    }

    json="$(mktemp /tmp/podkop-guard-lkg.XXXXXX)" || return 1

    if ! run_nice sing-box rule-set decompile --output "$json" "$LKG_SRS" >/dev/null 2>&1; then
        rm -f "$json"
        err "cannot decompile $LKG_SRS"
        return 1
    fi

    jq -r '
      "version=" + (.version|tostring),
      "rules=" + (.rules|length|tostring),
      "domains=" + ([.rules[]? | .domain_suffix? | select(. != null) | if type == "array" then .[] else . end] | length | tostring),
      "cidrs=" + ([.rules[]? | .ip_cidr? | select(. != null) | if type == "array" then .[] else . end] | length | tostring),
      "special_rules=" + ([.rules[]? | select(
        ((.type // "default") != "default") or
        ((keys_unsorted - ["type","domain_suffix","ip_cidr"]) | length) > 0
      )] | length | tostring)
    ' "$json"

    rm -f "$json"
}

derive_subnets() {
    local json new count special_count skipped_cidrs rc

    need jq || return 1
    need sing-box || return 1
    need sort || return 1
    need cmp || return 1
    ensure_state_dir || return 1

    [ -s "$LKG_SRS" ] || {
        err "LKG ruleset not found: $LKG_SRS"
        return 1
    }

    json="$(mktemp /tmp/podkop-guard-lkg.XXXXXX)" || return 1
    new="$STATE_DIR/.lkg-subnets.lst.new.$$"
    rc=1

    if run_nice sing-box rule-set decompile --output "$json" "$LKG_SRS" >/dev/null 2>&1 &&
       ruleset_extract_plain_cidrs "$json" | sort -u > "$new"; then

        count="$(wc -l < "$new" | tr -d ' ')"
        if [ "${count:-0}" -eq 0 ]; then
            warn "no unconditional CIDRs; existing subnet LKG was not replaced"
            rm -f "$json" "$new"
            return 1
        fi
        local metrics
        metrics="$(ruleset_conditional_metrics "$json")" || {
            rm -f "$json" "$new"
            return 1
        }
        special_count="${metrics%% *}"
        skipped_cidrs="${metrics#* }"

        if [ -f "$LKG_SUBNETS" ] && cmp -s "$new" "$LKG_SUBNETS"; then
            log "subnet LKG unchanged ($count CIDRs)"
        else
            mv "$new" "$LKG_SUBNETS" && chmod 0644 "$LKG_SUBNETS" &&
                log "updated $LKG_SUBNETS ($count CIDRs)"
        fi

        if [ "${special_count:-0}" -gt 0 ]; then
            warn "skipped ${skipped_cidrs:-0} CIDRs from $special_count conditional rule(s)"
        fi
        rc=0
    else
        err "cannot derive subnet LKG"
    fi

    rm -f "$json" "$new"
    return "$rc"
}

cache_restore() {
    [ -s "$CACHE_LKG" ] || {
        err "persistent cache snapshot not found: $CACHE_LKG"
        return 1
    }

    if pidof sing-box >/dev/null 2>&1; then
        err "sing-box is running; refusing to overwrite its live cache"
        return 1
    fi

    mkdir -p /tmp/sing-box || return 1
    cp "$CACHE_LKG" "$CACHE_RUNTIME" || return 1
    chmod 0600 "$CACHE_RUNTIME"
    log "restored cache snapshot to $CACHE_RUNTIME"
}

boot_restore() {
    local path
    path="$(configured_cache_path)"

    if [ "$path" != "$EXPECTED_CACHE_PATH" ]; then
        warn "boot restore skipped: Podkop cache_path is $path, expected $EXPECTED_CACHE_PATH"
        return 0
    fi

    if [ ! -s "$CACHE_LKG" ]; then
        warn "boot restore skipped: persistent cache snapshot is missing"
        return 0
    fi

    if pidof sing-box >/dev/null 2>&1; then
        log "boot restore skipped: sing-box is already running"
        return 0
    fi

    mkdir -p /tmp/sing-box || {
        err "boot restore failed: cannot create /tmp/sing-box"
        return 1
    }

    cp "$CACHE_LKG" "$CACHE_RUNTIME" || {
        err "boot restore failed: cannot copy persistent cache"
        return 1
    }
    chmod 0600 "$CACHE_RUNTIME"
    log "restored persistent sing-box cache snapshot before Podkop startup"
    return 0
}

wait_seconds() {
    local remaining chunk
    remaining="$1"

    while [ "$remaining" -gt 0 ] && [ "$STOP_REQUESTED" -eq 0 ]; do
        chunk=60
        [ "$remaining" -lt 60 ] && chunk="$remaining"
        sleep "$chunk"
        remaining=$((remaining - chunk))
    done
}

daemon_loop() {
    local age rc

    SYSLOG_MODE=1
    PODKOP_GUARD_SYSLOG=1
    export PODKOP_GUARD_SYSLOG

    check_requirements || return 1

    trap 'STOP_REQUESTED=1' TERM INT
    log "daemon started; startup grace ${STARTUP_GRACE}s, check interval ${CHECK_INTERVAL}s, refresh interval ${REFRESH_INTERVAL}s"

    wait_seconds "$STARTUP_GRACE"

    while [ "$STOP_REQUESTED" -eq 0 ]; do
        if refresh_due; then
            if runtime_ready; then
                age="$(lkg_age 2>/dev/null)"
                log "LKG refresh is due (age ${age:-unknown}s)"
                refresh_snapshot 1
                rc=$?
                if [ "$rc" -ne 0 ]; then
                    warn "validated refresh attempt failed; will retry after ${CHECK_INTERVAL}s"
                fi
            else
                warn "LKG refresh is due, but Podkop/sing-box runtime is not ready; will retry after ${CHECK_INTERVAL}s"
            fi
        fi

        wait_seconds "$CHECK_INTERVAL"
    done

    cleanup_update
    log "daemon stopped"
    return 0
}

status() {
    local age due path lists type

    printf 'podkop-guard %s\n' "$VERSION"
    printf 'state_dir=%s\n' "$STATE_DIR"
    path="$(configured_cache_path)"
    printf 'podkop_cache_path=%s\n' "$path"
    lists="$(community_lists)"
    printf 'community_lists=%s\n' "${lists:-none}"
    type="$(podkop_connection_type)"
    printf 'podkop_main_type=%s\n' "${type:-unknown}"

    if [ -s "$LKG_SRS" ]; then
        printf 'lkg_srs=%s bytes\n' "$(wc -c < "$LKG_SRS" | tr -d ' ')"
    else
        printf 'lkg_srs=missing\n'
    fi

    if [ -f "$LKG_SUBNETS" ]; then
        printf 'lkg_subnets=%s entries\n' "$(wc -l < "$LKG_SUBNETS" | tr -d ' ')"
    else
        printf 'lkg_subnets=missing\n'
    fi

    if [ -s "$CACHE_LKG" ]; then
        printf 'cache_snapshot=%s bytes\n' "$(wc -c < "$CACHE_LKG" | tr -d ' ')"
        age="$(lkg_age 2>/dev/null)"
        printf 'lkg_age_seconds=%s\n' "${age:-unknown}"
        if refresh_due; then due=yes; else due=no; fi
        printf 'refresh_due=%s\n' "$due"
    else
        printf 'cache_snapshot=missing\n'
        printf 'refresh_due=yes\n'
    fi

    if runtime_ready; then
        printf 'podkop_runtime=ready\n'
    else
        printf 'podkop_runtime=not_ready\n'
    fi

    printf 'startup_grace=%s\n' "$STARTUP_GRACE"
    printf 'check_interval=%s\n' "$CHECK_INTERVAL"
    printf 'refresh_interval=%s\n' "$REFRESH_INTERVAL"
}

# Experimental observe-only runtime probe. It never signals a process, modifies
# UCI/nftables or starts/stops Podkop. Three observations are NOT a full end-to-end
# connectivity check: client LAN traffic can differ from router-local probes.
#
# PID lookup adapted from podkop-net/podkop-engine failsafe; see THIRD_PARTY.md.
# Linux /proc/PID/stat field 22 (clock ticks since boot). Do not use
# numeric PID alone or assume a successful procd RPC proves continuity.
watch_process_birth() (
    local line rest
    case "$2" in ''|*[!0-9]*) exit 1 ;; esac
    [ "$2" -gt 1 ] 2>/dev/null || exit 1
    { IFS= read -r line < "$1/$2/stat"; } 2>/dev/null || exit 1
    [ "${line%% *}" = "$2" ] || exit 1
    case "$line" in *') '*) rest=${line##*) } ;; *) exit 1 ;; esac
    set -- $rest
    [ "$#" -ge 20 ] || exit 1
    case "$1" in R|S|D|T|t|I|W|P) ;; *) exit 1 ;; esac
    case "${20}" in ''|*[!0-9]*) exit 1 ;; esac
    printf '%s\n' "${20}"
)

# Verify the actual runtime against the registered argv without logging it.
# Supported command strings are printable ASCII, at most 8192 bytes
# including NUL separators. Unsupported layouts fail closed.
watch_runtime_matches() (
    local root pid birth argv before after exe actual
    root=$1 pid=$2 birth=$3 argv=$4
    [ -n "$argv" ] || exit 1
    before=$(watch_process_birth "$root" "$pid") || exit 1
    [ "$before" = "$birth" ] || exit 1
    exe=$(readlink "$root/$pid/exe" 2>/dev/null) || exit 1
    [ "$exe" = /usr/bin/sing-box ] || exit 1
    # hexdump preserves empty arguments, embedded spaces and trailing NUL.
    # Read one byte beyond the maximum supported argv; no pipe hides
    # read failure. The encoded result is private and bounded.
    actual=$(LC_ALL=C hexdump -v -n 8193 -e '1/1 "%02x"' "$root/$pid/cmdline" 2>/dev/null) || exit 1
    [ "$actual" = "$argv" ] || exit 1
    [ "$(readlink "$root/$pid/exe" 2>/dev/null)" = "$exe" ] || exit 1
    after=$(watch_process_birth "$root" "$pid") || exit 1
    [ "$after" = "$birth" ]
)

# Command identity is a bounded digest of the already validated argv,
# not a secret or proof of an atomic process identity. Never emit raw argv.
watch_valid_command_id() {
    [ "${#1}" -eq 64 ] || return 1
    case "$1" in *[!0-9a-f]*) return 1 ;; esac
}

watch_command_id() (
    local digest
    digest=$(printf '%s' "$1" | sha256sum) || exit 1
    digest=${digest%% *}
    watch_valid_command_id "$digest" || exit 1
    printf '%s\n' "$digest"
)

watch_valid_bus_identity() {
    case "$1" in ''|*[!0-9:]*|:*|*:|*:*:*) return 1 ;; *:*) return 0 ;; *) return 1 ;; esac
}

watch_runtime_bus() {
    watchdog_procd_bus_identity && watch_valid_bus_identity "$WATCH_PROCD_BUS_ID"
}

# Compare the bus identity across the sample, not just RPC success.
watch_runtime_bus_verify() {
    if ! watch_runtime_bus; then
        printf 'WATCHDOG state=UNKNOWN reason=ubusd_identity_unavailable nft=%s\n' "$WATCH_NFT"
        return 2
    fi
    if [ "$WATCH_PROCD_BUS_ID" != "$1" ]; then
        printf 'WATCHDOG state=TRANSITION reason=ubusd_changed nft=%s\n' "$WATCH_NFT"
        return 1
    fi
    return 0
}

watch_box_pid() {
    local report rest
    WATCH_PID=none
    WATCH_RUNNING=unknown
    WATCH_PROCD_STATE=UNKNOWN
    WATCH_PROCD_ARGV=
    WATCH_PROCD_REASON=procd_invalid_reply
    report=$(watch_procd_report) || return 2
    case "$report" in
        'PROCD_SNAPSHOT state=RUNNING pid='*' argv='*' action=none')
            rest=${report#* pid=}; WATCH_PID=${rest%% *}
            rest=${report#* argv=}; WATCH_PROCD_ARGV=${rest%% *}
            case "$WATCH_PROCD_ARGV" in ''|*[!0-9a-f]*) return 2 ;; esac
            WATCH_RUNNING=true
            WATCH_PROCD_STATE=RUNNING
            return 0 ;;
        'PROCD_SNAPSHOT state=STOPPED '*)
            WATCH_RUNNING=false
            WATCH_PROCD_STATE=STOPPED
            WATCH_PROCD_REASON=procd_stopped
            return 1 ;;
        'PROCD_SNAPSHOT state=UNREGISTERED '*)
            WATCH_PROCD_STATE=UNREGISTERED
            WATCH_PROCD_REASON=procd_unregistered
            return 1 ;;
        'PROCD_SNAPSHOT state=UNKNOWN reason=ubus_unavailable action=none')
            WATCH_PROCD_REASON=procd_unavailable ;;
    esac
    return 2
}

watch_nft_table() {
    local tables
    WATCH_NFT="unknown"
    tables=$(nft list tables 2>/dev/null) || return 0
    if printf '%s\n' "$tables" | grep -q '^[[:space:]]*table inet PodkopTable[[:space:]]*$'; then
        WATCH_NFT="present"
    else
        WATCH_NFT="absent"
    fi
}

# Minimal Podkop 0.7.24 structural contract, not full ruleset validation.
# Terse JSON avoids reading set contents. Do not log raw nft output.
watch_nft_structure() {
    local raw result
    raw=$(nft -j -t list table inet PodkopTable 2>/dev/null) || {
        # Distinguish disappearance from a failed structural read.
        watch_nft_table
        [ "$WATCH_NFT" != present ] || WATCH_NFT=unknown
        return 0
    }
    result=$(printf '%s\n' "$raw" | jq -sr '
        def objects($kind; $name):
            [.nftables[] | .[$kind]? | select(type == "object" and
                .family == "inet" and .table == "PodkopTable" and .name == $name)];
        def chain_ok($name; $type; $hook; $prio):
            objects("chain"; $name) as $c |
            ($c|length) == 1 and
            ($c[0] | .type == $type and .hook == $hook and .prio == $prio and .policy == "accept");
        def set_ok($name; $type):
            objects("set"; $name) as $s |
            ($s|length) == 1 and ($s[0].type == $type);
        # Required signatures must occur in the same rule and correct chain.
        # This is deliberately not a semantic evaluator of the whole ruleset.
        def rules($chain):
            .nftables[] | .rule? | select(type == "object" and
                .family == "inet" and .table == "PodkopTable" and .chain == $chain) |
                .expr | select(type == "array");
        def eq($left; $right):
            any(.[]; .match? | .op == "==" and .left == $left and .right == $right);
        def lookup($left; $right):
            any(.[]; .match? | (.op == "==" or .op == "in") and
                .left == $left and .right == $right);
        def meta($key): {"meta":{"key":$key}};
        def proto($name; $number):
            eq(meta("l4proto"); $name) or eq(meta("l4proto"); $number);
        def mark_path($chain; $dest; $name; $number):
            any(rules($chain);
                proto($name; $number) and
                lookup({"payload":{"protocol":"ip","field":"daddr"}}; $dest) and
                ($chain != "mangle" or lookup(meta("iifname"); "@interfaces")) and
                any(.[]; .mangle? | .key == meta("mark") and .value == 1048576));
        def mark_paths($chain):
            {"prefix":{"addr":"198.18.0.0","len":15}} as $range |
            mark_path($chain; $range; "tcp"; 6) and
            mark_path($chain; $range; "udp"; 17) and
            mark_path($chain; "@podkop_subnets"; "tcp"; 6) and
            mark_path($chain; "@podkop_subnets"; "udp"; 17);
        def proxy_path($name; $number):
            any(rules("proxy");
                proto($name; $number) and
                any(.[]; .match? |
                    .left == {"&":[{"meta":{"key":"mark"}},1048576]} and
                    ((.op == "==" and .right == 1048576) or
                     (.op == "!=" and .right == 0))) and
                any(.[]; .tproxy? | .family == "ip" and
                    .addr == "127.0.0.1" and .port == 1602));
        def rules_ok:
            mark_paths("mangle") and mark_paths("mangle_output") and
            proxy_path("tcp"; 6) and proxy_path("udp"; 17) and
            any(rules("mangle_output"); eq(meta("mark"); 2097152) and
                any(.[]; has("return")));
        if length != 1 or (.[0]|type) != "object" or
           (.[0].nftables|type) != "array" then "unknown"
        else .[0] |
            [.nftables[] | .table? | select(type == "object" and
                .family == "inet" and .name == "PodkopTable")] as $table |
            if ($table|length) != 1 then "unknown"
            elif ($table[0].flags // [] | length) != 0 then "unsupported"
            elif (objects("chain"; "mangle")|length) == 0 or
                 (objects("chain"; "mangle_output")|length) == 0 or
                 (objects("chain"; "proxy")|length) == 0 or
                 (objects("set"; "localv4")|length) == 0 or
                 (objects("set"; "podkop_subnets")|length) == 0 or
                 (objects("set"; "interfaces")|length) == 0 then "partial"
            elif chain_ok("mangle"; "filter"; "prerouting"; -150) and
                 chain_ok("mangle_output"; "route"; "output"; -150) and
                 chain_ok("proxy"; "filter"; "prerouting"; -100) and
                 set_ok("localv4"; "ipv4_addr") and
                 set_ok("podkop_subnets"; "ipv4_addr") and
                 set_ok("interfaces"; "ifname") then
                if rules_ok then "present" else "rules_incomplete" end
            else "unsupported"
            end
        end
    ' 2>/dev/null) || result=unknown
    case "$result" in
        present|partial|unsupported|rules_incomplete) WATCH_NFT=$result ;;
        *) WATCH_NFT=unknown ;;
    esac
}

# A missing or unreadable Podkop table cannot establish a valid local DNS
# sample. Keep the existing inactive/maintenance decisions separate.
watch_nft_require_present() {
    local reason
    case "$WATCH_NFT" in
        present) return 0 ;;
        absent) reason=nft_table_absent ;;
        partial) reason=nft_structure_partial ;;
        rules_incomplete) reason=nft_rules_incomplete; WATCH_NFT=partial ;;
        unsupported) reason=nft_structure_unsupported ;;
        *) reason=nft_table_unavailable ;;
    esac
    printf 'WATCHDOG state=UNKNOWN reason=%s pid=%s dns=%s nft=%s\n' "$reason" "$WATCH_PID" "$WATCH_DNS" "$WATCH_NFT"
    return 1
}

# Check the answer section, never the nslookup 'Server' banner. This probe is
# entirely local and should not depend on the selected VPN or external DNS.
watch_fakeip() {
    printf '%s\n' "$WATCH_ANSWER" | awk '
        /^Name:[[:space:]]/ {
            name = tolower($2)
            sub(/\.$/, "", name)
            answer = (name == "fakeip.podkop.fyi")
            next
        }
        answer && /^Address:[[:space:]]/ {
            n = split($2, octet, /\./)
            if (n == 4 && octet[1] == 198 &&
                (octet[2] == 18 || octet[2] == 19) &&
                octet[3] ~ /^[0-9]+$/ && octet[4] ~ /^[0-9]+$/ &&
                octet[3] >= 0 && octet[3] <= 255 &&
                octet[4] >= 0 && octet[4] <= 255) found = 1
        }
        END { exit(found ? 0 : 1) }
    '
}

watch_probe_dns() {
    local rc
    WATCH_ANSWER=$(nslookup -timeout=3 -retry=1 -type=A fakeip.podkop.fyi 127.0.0.42 2>&1)
    rc=$?
    # BusyBox nslookup exit codes vary; DNS error replies are not silence.
    case "$WATCH_ANSWER" in
        *SERVFAIL*|*'server failure'*) WATCH_DNS=servfail ;;
        *REFUSED*|*'Connection refused'*|*'connection refused'*) WATCH_DNS=refused ;;
        *NXDOMAIN*|*'Non-existent domain'*) WATCH_DNS=nxdomain ;;
        *"can't find"*) WATCH_DNS=unconfirmed ;;
        *'timed out'*|*'no servers could be reached'*) WATCH_DNS=timeout ;;
        *)
            if [ "$rc" -eq 0 ] && watch_fakeip; then WATCH_DNS=fakeip
            else WATCH_DNS=unconfirmed
            fi ;;
    esac
}

# A loopback ICMP control can suppress a DNS-hang candidate ONLY after the
# same procd PID previously answered ICMP successfully. ICMP is NOT DNS.
watch_local_loopback() {
    WATCH_LOOPBACK=unverified
    command -v ping >/dev/null 2>&1 || return 1
    if ping -c 1 -W 1 127.0.0.42 >/dev/null 2>&1; then
        WATCH_LOOPBACK=ok
        return 0
    fi
    return 1
}

# Match NUL-delimited argv, not flattened command-line substrings.
# Only the supported Podkop script and exact operation token count.
watch_maintenance_command() {
    local cmd
    if [ "${maintenance_reader:-hex}" = builtin ]; then
        # All supported tokens are shorter than 32 bytes. A capped read
        # cannot match an unterminated token; at most 3 * 32 bytes are read.
        {
            IFS= read -r -d '' -n 32 cmd || return 1
            case "$cmd" in
                /bin/sh|/bin/ash|sh|ash) IFS= read -r -d '' -n 32 cmd || return 1 ;;
            esac
            [ "$cmd" = /usr/bin/podkop ] || return 1
            IFS= read -r -d '' -n 32 cmd || return 1
            case "$cmd" in
                list_update) WATCH_MAINTENANCE=list_update ;;
                start|stop|reload|restart) WATCH_MAINTENANCE=podkop_lifecycle ;;
                *) return 1 ;;
            esac
        } 2>/dev/null < "$1"
        return $?
    fi
    cmd=$(LC_ALL=C hexdump -v -n 128 -e '1/1 "%02x"' "$1" 2>/dev/null) || return 1
    # Strip an optional known shell interpreter (hex includes terminal NUL).
    case "$cmd" in
        2f62696e2f736800*) cmd=${cmd#2f62696e2f736800} ;; # /bin/sh
        2f62696e2f61736800*) cmd=${cmd#2f62696e2f61736800} ;; # /bin/ash
        736800*) cmd=${cmd#736800} ;; # sh
        61736800*) cmd=${cmd#61736800} ;; # ash
    esac
    case "$cmd" in
        2f7573722f62696e2f706f646b6f7000*) cmd=${cmd#2f7573722f62696e2f706f646b6f7000} ;; # /usr/bin/podkop
        *) return 1 ;;
    esac
    case "$cmd" in
        6c6973745f75706461746500*) WATCH_MAINTENANCE=list_update ;;
        737461727400*|73746f7000*|72656c6f616400*|7265737461727400*)
            WATCH_MAINTENANCE=podkop_lifecycle ;;
        *) return 1 ;;
    esac
    return 0
}

watch_maintenance_active() {
    local proc_root list_pid_file pid proc maintenance_reader cmd LC_ALL
    LC_ALL=C
    proc_root="${PODKOP_GUARD_WATCH_PROC_ROOT:-/proc}"
    list_pid_file="${PODKOP_GUARD_WATCH_LIST_PID_FILE:-/var/run/podkop_list_update.pid}"
    WATCH_MAINTENANCE=""
    # Detect actual NUL-delimited and length-limited read support once per
    # scan. Minimal/custom shells without these extensions keep hexdump.
    maintenance_reader=hex
    if printf 'x\000y\000abc\000z' | (
        IFS= read -r -d '' -n 2 cmd && [ "$cmd" = x ] &&
        IFS= read -r -d '' -n 2 cmd && [ "$cmd" = y ] &&
        IFS= read -r -d '' -n 2 cmd && [ "$cmd" = ab ] &&
        IFS= read -r -d '' -n 2 cmd && [ "$cmd" = c ] &&
        ! IFS= read -r -d '' -n 2 cmd
    ) 2>/dev/null; then
        maintenance_reader=builtin
    fi

    if [ -r "$list_pid_file" ]; then
        read -r pid 2>/dev/null < "$list_pid_file" || pid=""
        case "$pid" in
            ''|*[!0-9]*) pid="" ;;
        esac
        if [ -n "$pid" ] && [ -r "$proc_root/$pid/cmdline" ]; then
            # The process can exit between the check and open.
            watch_maintenance_command "$proc_root/$pid/cmdline" && return 0
        fi
    fi

    # Cron/manual list_update may have no PID file.
    for proc in "$proc_root"/[0-9]*/cmdline; do
        [ -r "$proc" ] || continue
        watch_maintenance_command "$proc" && return 0
    done
    return 1
}

# A nearly-full conntrack table can delay local probes; suppress a definitive
# hang diagnosis if direct evidence of pressure exists.
watch_conntrack_status() {
    local base count max threshold
    WATCH_CONNTRACK=unverified
    base="${PODKOP_GUARD_WATCH_CONNTRACK_ROOT:-/proc/sys/net/netfilter}"
    [ -r "$base/nf_conntrack_count" ] && [ -r "$base/nf_conntrack_max" ] || return 1
    read -r count < "$base/nf_conntrack_count" || return 1
    read -r max < "$base/nf_conntrack_max" || return 1
    case "$count" in ''|*[!0-9]*) return 1 ;; esac
    case "$max" in ''|*[!0-9]*) return 1 ;; esac
    [ "${#count}" -le 12 ] && [ "${#max}" -le 12 ] || return 1
    [ "$max" -gt 0 ] || return 1
    threshold=$((max - max / 20))
    if [ "$count" -ge "$threshold" ]; then WATCH_CONNTRACK=pressure
    else WATCH_CONNTRACK=normal
    fi
    return 0
}

# Podkop owns the generated file; OpenWrt procd identifies the running
# command. Require both UCI paths and the exact verified argv to agree.
# The package init uses run -c FILE [-D WORKDIR]. Other layouts are unknown.
watch_config_path() {
    local pod_path box_path expected tail
    WATCH_CONFIG_PATH=
    WATCH_CONFIG_REASON=dns_config_path_unavailable
    pod_path=$(uci -q get podkop.settings.config_path 2>/dev/null) || return 1
    box_path=$(uci -q get sing-box.main.conffile 2>/dev/null) || return 1
    case "$pod_path" in /*) ;; *) return 1 ;; esac
    WATCH_CONFIG_REASON=dns_config_path_mismatch
    [ "$pod_path" = "$box_path" ] || return 1
    expected=$(printf '%s\000' /usr/bin/sing-box run -c "$pod_path" |
        LC_ALL=C hexdump -v -e '1/1 "%02x"') || return 1
    [ -n "$expected" ] || return 1
    case "$1" in
        "$expected") ;;
        "$expected"2d44002f*00)
            # -D must be one absolute argument, not more flags or files.
            tail=${1#"$expected"2d4400}
            tail=${tail%00}
            case "$tail" in *00*) return 1 ;; esac ;;
        *) return 1 ;;
    esac
    WATCH_CONFIG_REASON=dns_config_file_unavailable
    [ -f "$pod_path" ] && [ -r "$pod_path" ] || return 1
    WATCH_CONFIG_PATH=$pod_path
    return 0
}

# Inspect only the supported local DNS path. The validated canonical JSON
# is private and transient; its digest is a sampled disk generation, not
# proof of the configuration loaded in the running process.
watch_config_check() {
    local result hash_rc digest
    WATCH_CONFIG_ID=
    if watch_config_path "$1"; then
        WATCH_CONFIG_REASON=unsupported_dns_config
        # Hash the same validated, sorted JSON without a trailing newline.
        # FD 3 reports jq status separately from its data stream; the hash
        # is emitted after EOF. A successful hash alone is not validation.
        hash_rc=0
        result=$(
            exec 3>&1
            {
                jq_rc=0
                jq -jcesS '
            def includes($value):
                if type == "string" then . == $value
                elif type == "array" then all(.[]; type == "string") and any(.[]; . == $value)
                else false end;
            def only($allowed): (keys - $allowed | length) == 0;
            def dns_in:
                [.inbounds[] | select(.tag == "dns-in")] as $in |
                ($in|length) == 1 and ($in[0] |
                    .type == "direct" and .listen == "127.0.0.42" and
                    .listen_port == 53 and (.network == null or .network == "udp") and
                    .override_address == null and .override_port == null);
            def fakeip_server:
                [.dns.servers[] | select(.tag == "fakeip-server")] as $s |
                ($s|length) == 1 and ($s[0] |
                    .type == "fakeip" and .inet4_range == "198.18.0.0/15");
            def service_rule:
                any(.dns.rules[]; .action == "route" and .server == "fakeip-server" and
                    (.domain | includes("fakeip.podkop.fyi")) and
                    (.type == null or .type == "default") and
                    only(["action","server","domain","rewrite_ttl","type","__service_tag"]));
            def dns_route:
                reduce .route.rules[] as $r ({sniff:false,ok:false};
                    if ($r | .action == "sniff" and (.inbound | includes("dns-in")) and
                        only(["action","inbound","__service_tag"])) then .sniff = true
                    elif .sniff and ($r | .action == "hijack-dns" and
                        (.protocol | includes("dns")) and
                        (.inbound == null or (.inbound | includes("dns-in"))) and
                        only(["action","protocol","inbound","__service_tag"])) then .ok = true
                    else . end) | .ok;
            if length == 1 then .[0] |
                select(type == "object" and (.inbounds|type) == "array" and
                    (.dns.servers|type) == "array" and (.dns.rules|type) == "array" and
                    (.route.rules|type) == "array" and dns_in and fakeip_server and
                    service_rule and dns_route)
            else empty end
        ' "$WATCH_CONFIG_PATH" 2>/dev/null 3>&- || jq_rc=$?
                printf 'jq_rc=%s\n' "$jq_rc" >&3
            } | sha256sum 2>/dev/null 3>&-
        ) || hash_rc=$?
        case "$result" in
            'jq_rc=0'|'jq_rc=0
'*)
                WATCH_CONFIG_REASON=dns_config_identity_unavailable
                digest=${result#*'
'}
                digest=${digest%'  -'}
                if [ "$hash_rc" -eq 0 ] && watch_valid_command_id "$digest"; then
                    WATCH_CONFIG_ID=$digest
                    return 0
                fi ;;
        esac
    fi
    printf 'WATCHDOG state=UNKNOWN reason=%s pid=%s dns=%s nft=%s\n' "$WATCH_CONFIG_REASON" "$WATCH_PID" "$WATCH_DNS" "$WATCH_NFT"
    return 1
}

watchdog_check() {
    local tool shutdown check_pid rc check_birth check_bus current_birth control_identity initial_procd_state check_argv command_id check_config_id
    WATCH_PID="none"
    WATCH_RUNNING="unknown"
    WATCH_NFT="unknown"
    WATCH_DNS="skipped"
    WATCH_LOOPBACK=skipped
    WATCH_CONNTRACK=unverified
    WATCH_MAINTENANCE=""

    for tool in ubus nft jq nslookup uci awk grep tr hexdump readlink sha256sum; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            printf 'WATCHDOG state=UNKNOWN reason=missing_tool:%s\n' "$tool"
            return 2
        fi
    done

    watch_nft_table
    shutdown=$(uci -q get podkop.settings.shutdown_correctly 2>/dev/null)
    if [ "$shutdown" = "1" ] && [ "$WATCH_NFT" = "absent" ]; then
        printf 'WATCHDOG state=INACTIVE reason=podkop_stopped nft=%s\n' "$WATCH_NFT"
        return 0
    fi

    if ! watch_runtime_bus; then
        printf 'WATCHDOG state=UNKNOWN reason=ubusd_identity_unavailable nft=%s\n' "$WATCH_NFT"
        return 2
    fi
    check_bus=$WATCH_PROCD_BUS_ID
    watch_box_pid
    rc=$?
    if [ "$rc" -eq 2 ]; then
        printf 'WATCHDOG state=UNKNOWN reason=%s nft=%s\n' "$WATCH_PROCD_REASON" "$WATCH_NFT"
        return 2
    fi
    if [ "$rc" -ne 0 ]; then
        initial_procd_state=$WATCH_PROCD_STATE
        if watch_maintenance_active; then
            printf 'WATCHDOG state=TRANSITION reason=%s pid=none nft=%s\n' "$WATCH_MAINTENANCE" "$WATCH_NFT"
            return 0
        fi
        # A new procd instance may appear between our two observations.
        watch_box_pid
        rc=$?
        if [ "$rc" -eq 2 ]; then
            printf 'WATCHDOG state=UNKNOWN reason=%s nft=%s\n' "$WATCH_PROCD_REASON" "$WATCH_NFT"
            return 2
        elif [ "$rc" -eq 0 ]; then
            printf 'WATCHDOG state=TRANSITION reason=procd_returned pid=%s nft=%s\n' "$WATCH_PID" "$WATCH_NFT"
            return 0
        fi
        if watch_maintenance_active; then
            printf 'WATCHDOG state=TRANSITION reason=%s pid=none nft=%s\n' "$WATCH_MAINTENANCE" "$WATCH_NFT"
            return 0
        fi
        watch_runtime_bus_verify "$check_bus"
        rc=$?
        case "$rc" in 1) return 0 ;; 2) return 2 ;; esac
        if [ "$WATCH_PROCD_STATE" != "$initial_procd_state" ]; then
            printf 'WATCHDOG state=TRANSITION reason=procd_registration_changed pid=none nft=%s\n' "$WATCH_NFT"
            return 0
        fi
        # Absence alone cannot establish that Podkop is expected to run.
        printf 'WATCHDOG state=UNKNOWN reason=%s pid=none nft=%s bus=%s\n' "$WATCH_PROCD_REASON" "$WATCH_NFT" "$check_bus"
        return 2
    fi

    # Even a successful local DNS reply during a known lifecycle operation
    # is not a stable baseline. Check both sides of the DNS observation.
    if watch_maintenance_active; then
        printf 'WATCHDOG state=TRANSITION reason=%s pid=%s nft=%s\n' "$WATCH_MAINTENANCE" "$WATCH_PID" "$WATCH_NFT"
        return 0
    fi

    watch_nft_require_present || return 2
    watch_nft_structure
    watch_nft_require_present || return 2

    check_pid="$WATCH_PID"
    check_birth=$(watch_process_birth "${PODKOP_GUARD_WATCH_PROC_ROOT:-/proc}" "$check_pid") || {
        printf 'WATCHDOG state=UNKNOWN reason=runtime_identity_unavailable pid=%s nft=%s\n' "$WATCH_PID" "$WATCH_NFT"
        return 2
    }
    check_argv=$WATCH_PROCD_ARGV
    if ! watch_runtime_matches "${PODKOP_GUARD_WATCH_PROC_ROOT:-/proc}" "$check_pid" "$check_birth" "$check_argv"; then
        printf 'WATCHDOG state=UNKNOWN reason=runtime_identity_unavailable pid=%s nft=%s\n' "$WATCH_PID" "$WATCH_NFT"
        return 2
    fi
    command_id=$(watch_command_id "$check_argv") || {
        printf 'WATCHDOG state=UNKNOWN reason=runtime_identity_unavailable pid=%s nft=%s\n' "$WATCH_PID" "$WATCH_NFT"
        return 2
    }
    watch_config_check "$check_argv" || return 2
    check_config_id=$WATCH_CONFIG_ID
    control_identity="$check_pid:$check_birth:$check_bus:$command_id:$check_config_id"
    watch_probe_dns
    # Collect loopback evidence before the final identity checks so a
    # replacement during ping cannot validate an old baseline.
    if { [ "$WATCH_DNS" = fakeip ] && [ "$WATCH_NFT" = present ] &&
         [ "${PODKOP_GUARD_WATCH_CONTROL_PROBE:-0}" = 1 ]; } ||
       { [ "$WATCH_DNS" = timeout ] &&
         [ "${PODKOP_GUARD_WATCH_LOOPBACK_BASELINE_ID:-}" = "$control_identity" ]; }; then
        watch_local_loopback || :
    fi

    # The service might have reloaded while nslookup ran. Re-read the PID to
    # avoid treating a normal transition as failure of the previous process.
    watch_box_pid
    rc=$?
    if [ "$rc" -eq 2 ]; then
        # A failed RPC is not evidence of a particular service transition.
        printf 'WATCHDOG state=UNKNOWN reason=%s nft=%s\n' "$WATCH_PROCD_REASON" "$WATCH_NFT"
        return 2
    fi
    if [ "$rc" -ne 0 ] || [ "$WATCH_PID" != "$check_pid" ]; then
        printf 'WATCHDOG state=TRANSITION reason=procd_pid_changed nft=%s\n' "$WATCH_NFT"
        return 0
    fi
    if watch_maintenance_active; then
        printf 'WATCHDOG state=TRANSITION reason=%s pid=%s dns=%s nft=%s\n' "$WATCH_MAINTENANCE" "$WATCH_PID" "$WATCH_DNS" "$WATCH_NFT"
        return 0
    fi
    current_birth=$(watch_process_birth "${PODKOP_GUARD_WATCH_PROC_ROOT:-/proc}" "$WATCH_PID") || {
        printf 'WATCHDOG state=UNKNOWN reason=runtime_identity_unavailable pid=%s nft=%s\n' "$WATCH_PID" "$WATCH_NFT"
        return 2
    }
    if [ "$current_birth" != "$check_birth" ] || [ "$WATCH_PROCD_ARGV" != "$check_argv" ]; then
        printf 'WATCHDOG state=TRANSITION reason=runtime_identity_changed nft=%s\n' "$WATCH_NFT"
        return 0
    fi
    if ! watch_runtime_matches "${PODKOP_GUARD_WATCH_PROC_ROOT:-/proc}" "$WATCH_PID" "$current_birth" "$WATCH_PROCD_ARGV"; then
        printf 'WATCHDOG state=UNKNOWN reason=runtime_identity_unavailable pid=%s nft=%s\n' "$WATCH_PID" "$WATCH_NFT"
        return 2
    fi
    watch_runtime_bus_verify "$check_bus"
    rc=$?
    case "$rc" in 1) return 0 ;; 2) return 2 ;; esac
    # Revalidate the minimum structure, not counters or set contents.
    # This is two observations, not an atomic ruleset generation check.
    watch_nft_structure
    watch_nft_require_present || return 2
    watch_config_check "$check_argv" || return 2
    if [ "$WATCH_CONFIG_ID" != "$check_config_id" ]; then
        printf 'WATCHDOG state=TRANSITION reason=dns_config_changed pid=%s nft=%s\n' "$WATCH_PID" "$WATCH_NFT"
        return 0
    fi
    if [ "$WATCH_DNS" = "fakeip" ] && [ "$WATCH_NFT" = "present" ]; then
        printf 'WATCHDOG state=HEALTHY_SAMPLED pid=%s dns=fakeip nft=present loopback=%s birth=%s bus=%s command_id=%s config_id=%s\n' "$WATCH_PID" "$WATCH_LOOPBACK" "$check_birth" "$check_bus" "$command_id" "$check_config_id"
        return 0
    fi
    if [ "$WATCH_DNS" = "timeout" ]; then
        if ! watch_conntrack_status; then
            printf 'WATCHDOG state=UNKNOWN reason=conntrack_unverified pid=%s dns=timeout nft=%s\n' "$WATCH_PID" "$WATCH_NFT"
            return 2
        fi
        if [ "$WATCH_CONNTRACK" = pressure ]; then
            printf 'WATCHDOG state=UNKNOWN reason=conntrack_pressure pid=%s dns=timeout nft=%s\n' "$WATCH_PID" "$WATCH_NFT"
            return 2
        fi
        # Only a successful loopback control for this same PID can be used
        # as an independent reason to suppress the DNS timeout candidate.
        if [ "${PODKOP_GUARD_WATCH_LOOPBACK_BASELINE_ID:-}" = "$control_identity" ] &&
           [ "$WATCH_LOOPBACK" != ok ]; then
            printf 'WATCHDOG state=UNKNOWN reason=loopback_unresponsive pid=%s dns=timeout nft=%s\n' "$WATCH_PID" "$WATCH_NFT"
            return 2
        fi
        printf 'WATCHDOG state=SUSPECT_DNS_TIMEOUT pid=%s dns=timeout nft=%s birth=%s bus=%s command_id=%s config_id=%s\n' "$WATCH_PID" "$WATCH_NFT" "$check_birth" "$check_bus" "$command_id" "$check_config_id"
        return 1
    fi
    printf 'WATCHDOG state=UNKNOWN pid=%s dns=%s nft=%s\n' "$WATCH_PID" "$WATCH_DNS" "$WATCH_NFT"
    return 2
}


# Bounded RAM-only monitor. This command never signals processes or modifies
# UCI, nftables, service state, cache/LKG or files. "CONFIRMED" means repeated
# local observations, not proof of a root cause or broken Internet.
watch_monitor_number() {
    case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac
}

watch_monitor_now() {
    local whole rest
    [ -r "$WATCH_MONITOR_UPTIME_FILE" ] || return 1
    read -r whole rest < "$WATCH_MONITOR_UPTIME_FILE" || return 1
    whole=${whole%%.*}
    watch_monitor_number "$whole" || return 1
    WATCH_MONITOR_NOW=$whole
}

# B5.2: only a member of the isolated session may signal its own group.
# The controller validates PID + starttime but never signals a numeric PGID.
watch_bounded_identity() {
    local line rest
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
    [ "$1" -gt 1 ] 2>/dev/null || return 1
    { IFS= read -r line < "/proc/$1/stat"; } 2>/dev/null || return 1
    rest=${line##*) }
    set -- $rest
    [ "$#" -ge 20 ] || return 1
    [ "$3" = "$4" ] || return 1
    printf '%s %s %s\n' "$3" "$4" "${20}"
}

watch_bounded_now() {
    local whole rest
    read -r whole rest < /proc/uptime || return 1
    whole=${whole%%.*}
    watch_monitor_number "$whole" || return 1
    WATCH_BOUND_NOW=$whole
}

watch_bounded_group_live() {
    local proc line rest identity
    [ -n "$WATCH_BOUND_PID" ] || return 1
    # A new leader with the same numeric PID cannot belong to the old session.
    if [ -r "/proc/$WATCH_BOUND_PID/stat" ]; then
        identity=$(watch_bounded_identity "$WATCH_BOUND_PID") || identity=
        if [ -n "$identity" ] && [ "$identity" != "$WATCH_BOUND_PID $WATCH_BOUND_PID $WATCH_BOUND_START" ]; then
            return 1
        fi
    fi
    for proc in /proc/[0-9]*/stat; do
        [ -r "$proc" ] || continue
        { IFS= read -r line < "$proc"; } 2>/dev/null || continue
        case "$line" in *') '*) rest=${line##*) } ;; *) continue ;; esac
        set -- $rest
        [ "$#" -ge 4 ] || continue
        case "$1" in Z|X|x) continue ;; esac
        [ "$3" = "$WATCH_BOUND_PID" ] && [ "$4" = "$WATCH_BOUND_PID" ] && return 0
    done
    return 1
}

watch_bounded_wait_quiet() {
    local until
    watch_bounded_now || return 1
    until=$((WATCH_BOUND_NOW + 4))
    while watch_bounded_group_live; do
        watch_bounded_now && [ "$WATCH_BOUND_NOW" -lt "$until" ] || return 1
        sleep 0.1 2>/dev/null || sleep 1
    done
    return 0
}

# One kernel-owned slot for every bounded probe (manual and resident).
# FD 7 MUST remain inherited by the session, diagnostic and its children.
# Never unlock explicitly or unlink the lock inode, even after SIGKILL.
watch_bounded_private_dir() {
    local listing uid
    [ -d "$1" ] && [ ! -L "$1" ] || return 1
    # Stock OpenWrt disables BusyBox stat. ls -ldn provides mode and
    # numeric owner without requiring a new package. Fail closed.
    listing=$(LC_ALL=C ls -ldn "$1" 2>/dev/null) || return 1
    uid=$(id -u) || return 1
    set -- $listing
    [ "$#" -ge 4 ] && [ "$1" = drwx------ ] && [ "$3" = "$uid" ]
}

watch_bounded_slot_quiet() {
    local WATCH_BOUND_PID WATCH_BOUND_START
    [ -e "$1" ] || [ -L "$1" ] || return 0
    watch_bounded_private_dir "$1" && [ -r /proc/self/stat ] || return 1
    # The lease is primary. Preserve a surviving session even if a child
    # unexpectedly closed the inherited descriptor. Incomplete armed
    # metadata is fail-closed, not permission to overwrite the slot.
    if [ ! -e "$1/pid" ]; then
        [ ! -e "$1/armed" ]; return
    fi
    [ -f "$1/pid" ] && [ ! -L "$1/pid" ] &&
        read -r WATCH_BOUND_PID WATCH_BOUND_START < "$1/pid" &&
        watch_monitor_number "$WATCH_BOUND_PID" &&
        watch_monitor_number "$WATCH_BOUND_START" &&
        [ "$WATCH_BOUND_PID" -gt 1 ] || return 1
    ! watch_bounded_group_live
}

watch_bounded_remove_slot() {
    [ -e "$1" ] || [ -L "$1" ] || return 0
    watch_bounded_private_dir "$1" || return 1
    rm -f "$1/pid" "$1/result" "$1/rc" "$1/expired" "$1/armed" \
        "$1/notify" "$1/arm" "$1/cancel" "$1/finished" \
        "$1/guard" "$1/rc.tmp" "$1/owner" || return 1
    rmdir "$1"
}

watch_bounded_cleanup() {
    [ -n "$WATCH_BOUND_DIR" ] || return 0
    # Wake the session's own guard, never signal an externally chosen PID.
    : > "$WATCH_BOUND_DIR/cancel" 2>/dev/null || :
    if [ "$WATCH_BOUND_WAIT" = fifo ]; then
        printf 'cancel\n' >&9 2>/dev/null || :
    fi
    # Before a verified PID is armed, removing the directory is safe:
    # the leader requires the armed marker before launching the probe.
    if [ -z "$WATCH_BOUND_PID" ] || [ "$WATCH_BOUND_QUIET" = 1 ] || watch_bounded_wait_quiet; then
        rm -f "$WATCH_BOUND_DIR/pid" "$WATCH_BOUND_DIR/result" "$WATCH_BOUND_DIR/rc" \
            "$WATCH_BOUND_DIR/expired" "$WATCH_BOUND_DIR/armed" "$WATCH_BOUND_DIR/notify" \
            "$WATCH_BOUND_DIR/arm" "$WATCH_BOUND_DIR/cancel" "$WATCH_BOUND_DIR/finished" \
            "$WATCH_BOUND_DIR/guard" "$WATCH_BOUND_DIR/rc.tmp" "$WATCH_BOUND_DIR/owner"
        rmdir "$WATCH_BOUND_DIR" 2>/dev/null || :
    fi
    if [ "$WATCH_BOUND_WAIT" = fifo ]; then
        exec 8>&- 9>&-
    fi
    WATCH_BOUND_DIR=
}

# Private entry: only an armed, lease-owning probe session may sample.
# This is a containment contract, not a security boundary against root.
watch_internal_context() {
    local root dir lease line leader birth extra owner owner_birth identity
    local tag sequence kind advisory mode rest locked
    root=/tmp/podkop-guard-probe.lock
    dir="$root/active"
    lease="$root/lease"
    [ -d "$root" ] && [ ! -L "$root" ] && [ -d "$dir" ] && [ ! -L "$dir" ] &&
        [ -f "$lease" ] && [ ! -L "$lease" ] &&
        [ -f "$dir/armed" ] && [ ! -L "$dir/armed" ] &&
        [ ! -e "$dir/cancel" ] && [ ! -L "$dir/cancel" ] &&
        [ -f "$dir/pid" ] && [ ! -L "$dir/pid" ] &&
        [ -f "$dir/owner" ] && [ ! -L "$dir/owner" ] || return 1
    read -r leader birth extra < "$dir/pid" && [ -z "$extra" ] &&
        watch_monitor_number "$leader" && watch_monitor_number "$birth" &&
        [ "$leader" -gt 1 ] || return 1
    read -r owner owner_birth extra < "$dir/owner" && [ -z "$extra" ] &&
        watch_monitor_number "$owner" && watch_monitor_number "$owner_birth" &&
        [ "$owner" -gt 1 ] && [ "$owner" != "$leader" ] || return 1
    IFS= read -r line < /proc/self/stat || return 1
    set -- ${line##*) }
    [ "$#" -ge 20 ] && [ "$3" = "$leader" ] && [ "$4" = "$leader" ] || return 1
    identity=$(watch_bounded_identity "$leader") || return 1
    [ "$identity" = "$leader $leader $birth" ] &&
        [ "$(watch_process_birth /proc "$leader")" = "$birth" ] &&
        [ "$(watch_process_birth /proc "$owner")" = "$owner_birth" ] || return 1
    [ "$(readlink /proc/self/fd/7 2>/dev/null)" = "$lease" ] &&
        [ "$(readlink "/proc/$leader/fd/7" 2>/dev/null)" = "$lease" ] &&
        [ "$(readlink "/proc/$owner/fd/7" 2>/dev/null)" = "$lease" ] || return 1
    # fdinfo reports the FLOCK on the inherited open file description.
    # Never acquire or release a lock here: the controller owns the lease.
    locked=0
    while read -r tag sequence kind advisory mode rest; do
        if [ "$tag" = 'lock:' ] && [ "$kind" = FLOCK ] &&
           [ "$advisory" = ADVISORY ] && [ "$mode" = WRITE ]; then
            locked=1
        fi
    done < /proc/self/fdinfo/7 2>/dev/null || return 1
    [ "$locked" = 1 ]
}

watchdog_check_internal() {
    if [ "$#" -ne 0 ] || ! watch_internal_context; then
        printf 'WATCHDOG state=UNKNOWN reason=probe_context_unverified\n'
        return 2
    fi
    watchdog_check
}

watchdog_check_bounded() (
    local limit script rc wake until identity owner_stat owner_pid lock_root lock_file
    [ "$#" -le 1 ] || { err "usage: watchdog-check-bounded [seconds 3..120]"; exit 2; }
    limit="$1"
    [ -n "$limit" ] || limit="$PODKOP_GUARD_WATCH_MAX_SAMPLE"
    [ -n "$limit" ] || limit=8
    watch_monitor_number "$limit" && [ "$limit" -ge 3 ] && [ "$limit" -le 120 ] || {
        err "bounded check limit must be 3..120 seconds"; exit 2
    }
    script="$PODKOP_GUARD_WATCH_CHECK_SCRIPT"
    [ -n "$script" ] || script="$0"
    [ -r "$script" ] && command -v setsid >/dev/null 2>&1 &&
        command -v mktemp >/dev/null 2>&1 || {
        printf 'WATCHDOG state=UNKNOWN reason=probe_isolation_unavailable\n'; exit 2
    }
    # OpenWrt ships flock by default. Fail closed on custom builds without it.
    lock_root=/tmp/podkop-guard-probe.lock
    lock_file="$lock_root/lease"
    umask 077
    command -v flock >/dev/null 2>&1 && command -v ls >/dev/null 2>&1 &&
        command -v id >/dev/null 2>&1 || {
        printf 'WATCHDOG state=UNKNOWN reason=probe_barrier_unavailable\n'; exit 2
    }
    mkdir -m 700 "$lock_root" 2>/dev/null || :
    watch_bounded_private_dir "$lock_root" && [ ! -L "$lock_file" ] &&
        { [ ! -e "$lock_file" ] || [ -f "$lock_file" ]; } || {
        printf 'WATCHDOG state=UNKNOWN reason=probe_barrier_unavailable\n'; exit 2
    }
    # No truncation/unlink. Opening a separate description is essential.
    # A failed lock (busy or error) must never authorize another probe.
    if ! { exec 7>>"$lock_file"; } 2>/dev/null; then
        printf 'WATCHDOG state=UNKNOWN reason=probe_barrier_unavailable\n'; exit 2
    fi
    if ! flock -n 7 2>/dev/null; then
        printf 'WATCHDOG state=UNKNOWN reason=probe_blocked\n'; exit 2
    fi
    WATCH_BOUND_DIR="$lock_root/active"
    # Only after acquiring the lease may a new controller reclaim old
    # private markers. No wildcard cleanup or growing per-probe directories.
    if ! watch_bounded_slot_quiet "$WATCH_BOUND_DIR" ||
       ! watch_bounded_slot_quiet "$WATCH_BOUND_DIR.abandoned"; then
        printf 'WATCHDOG state=UNKNOWN reason=probe_blocked\n'; exit 2
    fi
    if ! watch_bounded_remove_slot "$WATCH_BOUND_DIR" ||
       ! watch_bounded_remove_slot "$WATCH_BOUND_DIR.abandoned" ||
       ! mkdir -m 700 "$WATCH_BOUND_DIR"; then
        printf 'WATCHDOG state=UNKNOWN reason=probe_tmp_unavailable\n'; exit 2
    fi
    WATCH_BOUND_PID=
    WATCH_BOUND_START=
    WATCH_BOUND_WAIT=poll
    WATCH_BOUND_QUIET=0
    trap 'watch_bounded_cleanup' EXIT
    trap 'exit 2' TERM INT
    # Record the actual controller (which may be a shell subshell), not $$.
    IFS= read -r owner_stat < /proc/self/stat || exit 2
    owner_pid=${owner_stat%% *}
    owner_stat=${owner_stat##*) }
    set -- $owner_stat
    [ "$#" -ge 20 ] && watch_monitor_number "$owner_pid" &&
        watch_monitor_number "${20}" && [ "$owner_pid" -gt 1 ] || exit 2
    printf '%s %s\n' "$owner_pid" "${20}" > "$WATCH_BOUND_DIR/owner" || exit 2
    if command -v mkfifo >/dev/null 2>&1 &&
       (IFS= read -r -t 1 wake 2>/dev/null <<'PG_TIMED_READ'
ready
PG_TIMED_READ
        [ "$wake" = ready ]) &&
       mkfifo "$WATCH_BOUND_DIR/notify" "$WATCH_BOUND_DIR/arm" 2>/dev/null; then
        exec 8<>"$WATCH_BOUND_DIR/notify" 9<>"$WATCH_BOUND_DIR/arm"
        WATCH_BOUND_WAIT=fifo
    fi
    setsid sh -c '
        script=$1 dir=$2 mode=$3 limit=$4
        # Confirm setsid/sh preserved the lease before any probe may run.
        [ "$(readlink /proc/self/fd/7 2>/dev/null)" = "${dir%/*}/lease" ] || exit 2
        read -r owner_pid owner_birth < "$dir/owner" || exit 2
        case "$owner_pid:$owner_birth" in *[!0-9:]*|:*|*:) exit 2 ;; esac
        [ "$owner_pid" -gt 1 ] || exit 2
        # Failure to read an existing proc entry is not proof of death.
        # Stopped owners are alive; zombies and recycled identities are not.
        owner_gone() {
            [ -d "/proc/$owner_pid" ] || return 0
            { IFS= read -r owner_line < "/proc/$owner_pid/stat"; } 2>/dev/null || return 1
            owner_rest=${owner_line##*) }
            set -- $owner_rest
            [ "$#" -ge 20 ] || return 1
            case "$1" in Z|X|x) return 0 ;; esac
            [ "${20}" != "$owner_birth" ]
        }
        reclaim_abandoned() {
            # Only the private directory of this session, never a global
            # /tmp sweep. Rename first so ongoing probe writes cannot
            # recreate files at the old pathname during cleanup.
            orphan="$dir.abandoned"
            if [ ! -e "$orphan" ] && [ ! -L "$orphan" ] &&
               mv -T "$dir" "$orphan" 2>/dev/null; then
                rm -f "$orphan/pid" "$orphan/result" "$orphan/rc" \
                    "$orphan/expired" "$orphan/armed" "$orphan/notify" \
                    "$orphan/arm" "$orphan/cancel" "$orphan/finished" \
                    "$orphan/guard" "$orphan/rc.tmp" "$orphan/owner"
                rmdir "$orphan" 2>/dev/null || :
            elif [ -d "$orphan" ]; then
                # The other supervisor may have won the rename. Give its
                # cleanup a bounded chance before signalling the group.
                sleep 1
            fi
        }
        # Verify the actual session leader, not the setsid launcher PID.
        IFS= read -r stat < /proc/self/stat || exit 2
        session_pid=${stat%% *}
        rest=${stat##*) }
        set -- $rest
        [ "$#" -ge 20 ] && [ "$session_pid" -gt 1 ] &&
            [ "$3" = "$session_pid" ] && [ "$4" = "$session_pid" ] || exit 2
        printf "%s %s\n" "$session_pid" "${20}" > "$dir/pid" || exit 2
        if [ "$mode" = fifo ]; then
            printf "pid\n" >&8
            IFS= read -r -t 3 wake <&9 || :
        else
            read -r now unused < /proc/uptime || exit 2
            until=$((${now%%.*} + 4))
            while [ ! -f "$dir/armed" ] && [ ! -f "$dir/cancel" ]; do
                read -r now unused < /proc/uptime || exit 2
                [ "${now%%.*}" -lt "$until" ] || break
                sleep 0.1 2>/dev/null || sleep 1
            done
        fi
        if [ ! -f "$dir/armed" ] || [ -f "$dir/cancel" ] || owner_gone; then
            if owner_gone; then reclaim_abandoned; fi
            exit 2
        fi
        # Both the independent guard and the leader enforce the deadline.
        # The leader remains responsive even if its guard is killed.
        read -r started unused < /proc/uptime || exit 2
        started_s=${started%%.*}
        started_f=${started#*.}
        case "$started_s" in ""|*[!0-9]*) exit 2 ;; esac
        case "$started_f" in [0-9][0-9]) ;; *) exit 2 ;; esac
        deadline_s=$((started_s + limit))
        deadline_reached() {
            read -r now unused < /proc/uptime || return 0
            now_s=${now%%.*}; now_f=${now#*.}
            case "$now_s" in ""|*[!0-9]*) return 0 ;; esac
            case "$now_f" in [0-9][0-9]) ;; *) return 0 ;; esac
            [ "$now_s" -gt "$deadline_s" ] ||
                { [ "$now_s" -eq "$deadline_s" ] && [ "$now_f" -ge "$started_f" ]; }
        }
        finish_group() {
            IFS= read -r stat < /proc/self/stat || exit 2
            rest=${stat##*) }
            set -- "$1" $rest
            [ "$#" -ge 5 ] && [ "$4" = "$session_pid" ] &&
                [ "$5" = "$session_pid" ] || exit 2
            if owner_gone; then
                reclaim_abandoned
                kill -KILL 0
                exit 2
            fi
            if [ "$1" = expired ] || deadline_reached || [ -f "$dir/cancel" ]; then
                : > "$dir/expired"
            fi
            : > "$dir/finished"
            if [ "$mode" = fifo ]; then printf "finished\n" >&8; fi
            # PID 0 targets the calling process group in the kernel.
            kill -KILL 0
        }
        (
            if [ "$mode" = fifo ]; then
                if IFS= read -r -t "$limit" wake <&9 &&
                   [ "$wake" = done ] && [ -s "$dir/rc" ] && [ ! -f "$dir/cancel" ]; then
                    finish_group complete
                else
                    finish_group expired
                fi
            else
                # dash has no timed read. Keep an independent exact sleep
                # deadline, and poll only for earlier completion/cancellation.
                (sleep "$limit"; finish_group expired) &
                while [ ! -s "$dir/rc" ] && [ ! -f "$dir/cancel" ]; do
                    sleep 0.1 2>/dev/null || sleep 1
                done
                if [ -f "$dir/cancel" ]; then finish_group expired; fi
                finish_group complete
            fi
        ) &
        guard_pid=$!
        printf "%s\n" "$guard_pid" > "$dir/guard" || finish_group expired
        (
            if [ "$mode" = fifo ]; then
                sh "$script" watchdog-check-internal > "$dir/result" 2>&1 8>&- 9>&-
                printf "%s\n" "$?" > "$dir/rc.tmp" && mv "$dir/rc.tmp" "$dir/rc"
                printf "done\n" >&9
            else
                sh "$script" watchdog-check-internal > "$dir/result" 2>&1
                printf "%s\n" "$?" > "$dir/rc.tmp" && mv "$dir/rc.tmp" "$dir/rc"
            fi
        ) &
        # Backup supervisor: if the independent guard disappears, the
        # leader still bounds the check and can signal its own group.
        while :; do
            if deadline_reached || [ -f "$dir/cancel" ]; then finish_group expired; fi
            if [ -s "$dir/rc" ]; then finish_group complete; fi
            # Only the independent guard may read the control FIFO after
            # arming. Two concurrent readers can split one notification.
            sleep 0.1 2>/dev/null || sleep 1
        done
    ' b5 "$script" "$WATCH_BOUND_DIR" "$WATCH_BOUND_WAIT" "$limit" >/dev/null 2>&1 &
    if [ "$WATCH_BOUND_WAIT" = fifo ]; then
        if [ ! -s "$WATCH_BOUND_DIR/pid" ]; then
            IFS= read -r -t 3 wake <&8 || :
        fi
    else
        watch_bounded_now || exit 2
        until=$((WATCH_BOUND_NOW + 4))
        while [ ! -s "$WATCH_BOUND_DIR/pid" ]; do
            watch_bounded_now && [ "$WATCH_BOUND_NOW" -lt "$until" ] || break
            sleep 0.1 2>/dev/null || sleep 1
        done
    fi
    if [ ! -s "$WATCH_BOUND_DIR/pid" ]; then
        printf 'WATCHDOG state=UNKNOWN reason=probe_start_unverified\n'; exit 2
    fi
    read -r WATCH_BOUND_PID WATCH_BOUND_START < "$WATCH_BOUND_DIR/pid" || WATCH_BOUND_PID=
    if ! watch_monitor_number "$WATCH_BOUND_PID" || ! watch_monitor_number "$WATCH_BOUND_START"; then
        WATCH_BOUND_PID=
        printf 'WATCHDOG state=UNKNOWN reason=probe_pid_invalid\n'; exit 2
    fi
    identity=$(watch_bounded_identity "$WATCH_BOUND_PID") || identity=
    if [ "$identity" != "$WATCH_BOUND_PID $WATCH_BOUND_PID $WATCH_BOUND_START" ]; then
        WATCH_BOUND_PID=
        printf 'WATCHDOG state=UNKNOWN reason=probe_isolation_unverified\n'; exit 2
    fi
    : > "$WATCH_BOUND_DIR/armed"
    if [ "$WATCH_BOUND_WAIT" = fifo ]; then printf 'armed\n' >&9; fi
    # Controller timeout is a separate upper bound if the guard itself fails.
    watch_bounded_now || exit 2
    until=$((WATCH_BOUND_NOW + limit + 4))
    while [ ! -f "$WATCH_BOUND_DIR/finished" ]; do
        if ! watch_bounded_now || [ "$WATCH_BOUND_NOW" -ge "$until" ]; then
            # The controller cannot verify termination. Inherited lease
            # prevents further probes until all surviving holders exit.
            printf 'WATCHDOG state=UNKNOWN reason=probe_uncontained\n'; exit 2
        fi
        if [ "$WATCH_BOUND_WAIT" = fifo ]; then
            IFS= read -r -t 1 wake <&8 || :
        else
            sleep 0.1 2>/dev/null || sleep 1
        fi
    done
    if watch_bounded_wait_quiet; then WATCH_BOUND_QUIET=1; fi
    if [ "$WATCH_BOUND_QUIET" != 1 ]; then
        printf 'WATCHDOG state=UNKNOWN reason=probe_uncontained\n'; exit 2
    fi
    if [ -f "$WATCH_BOUND_DIR/expired" ]; then
        printf 'WATCHDOG state=UNKNOWN reason=probe_hard_deadline\n'; exit 2
    fi
    read -r rc < "$WATCH_BOUND_DIR/rc" || rc=invalid
    case "$rc" in 0|1|2) ;; *)
        printf 'WATCHDOG state=UNKNOWN reason=probe_invalid_exit\n'; exit 2 ;;
    esac
    [ -s "$WATCH_BOUND_DIR/result" ] || {
        printf 'WATCHDOG state=UNKNOWN reason=probe_empty_output\n'; exit 2
    }
    [ "$(wc -c < "$WATCH_BOUND_DIR/result")" -le 2048 ] || {
        printf 'WATCHDOG state=UNKNOWN reason=probe_oversize_output\n'; exit 2
    }
    cat "$WATCH_BOUND_DIR/result"
    exit "$rc"
)

watchdog_monitor() {
    local cycles interval threshold grace sample_output sample_rc
    local sample_no state payload pid rest now armed_identity last_identity hold_until
    local missing_active streak streak_kind phase confirmations startup_deadline
    local stopped late_probe sample_elapsed max_sample display_cycles changes_only last_phase last_state
    local control_identity control_attempts control_probe sample_reason
    local birth bus identity last_bus command_id config_id maintenance_max maintenance_since

    [ "$#" -le 2 ] || {
        err "usage: podkop-guard watchdog-monitor [cycles 1..30] [interval_seconds 0..300]"
        return 2
    }
    cycles="${1:-6}"
    interval="${2:-20}"
    changes_only="${PODKOP_GUARD_WATCH_CHANGES_ONLY:-0}"
    threshold="${PODKOP_GUARD_WATCH_THRESHOLD:-3}"
    grace="${PODKOP_GUARD_WATCH_GRACE:-180}"
    max_sample="${PODKOP_GUARD_WATCH_MAX_SAMPLE:-8}"
    maintenance_max="${PODKOP_GUARD_WATCH_MAINTENANCE_MAX:-900}"
    WATCH_MONITOR_UPTIME_FILE="${PODKOP_GUARD_WATCH_UPTIME_FILE:-/proc/uptime}"

    for payload in "$cycles" "$interval" "$threshold" "$grace" "$max_sample" "$maintenance_max"; do
        watch_monitor_number "$payload" || { err "invalid monitor numeric argument"; return 2; }
    done
    { { [ "$cycles" -ge 1 ] && [ "$cycles" -le 30 ]; } ||
      { [ "$cycles" -eq 0 ] && [ "${PODKOP_GUARD_WATCH_UNBOUNDED:-0}" = "1" ]; }; } &&
    [ "$interval" -ge 0 ] && [ "$interval" -le 300 ] &&
    [ "$threshold" -ge 2 ] && [ "$threshold" -le 10 ] &&
    [ "$grace" -ge 0 ] && [ "$grace" -le 600 ] &&
    [ "$max_sample" -ge 3 ] && [ "$max_sample" -le 120 ] || {
        err "monitor limits: cycles=1..30 interval=0..300 threshold=2..10 grace=0..600"
        return 2
    }
    [ "$maintenance_max" -ge 1 ] && [ "$maintenance_max" -le 86400 ] || { err "maintenance diagnostic threshold must be 1..86400 seconds"; return 2; }
    [ "$changes_only" = "0" ] || [ "$changes_only" = "1" ] || { err "changes_only must be 0 or 1"; return 2; }
    [ -r "$0" ] || { err "monitor wrapper script is not readable"; return 2; }
    watch_monitor_now || { err "cannot read monotonic /proc/uptime"; return 2; }

    maintenance_since=""
    startup_deadline=$((WATCH_MONITOR_NOW + grace))
    hold_until=$startup_deadline
    armed_identity=""
    last_identity=""
    last_bus=""
    missing_active=0
    streak=0
    streak_kind=""
    confirmations=0
    stopped=0
    last_phase=""
    last_state=""
    control_identity=""
    control_attempts=0
    display_cycles=$cycles
    [ "$cycles" -eq 0 ] && display_cycles=continuous
    trap 'stopped=1' TERM INT

    printf 'MONITOR mode=observe-only cycles=%s interval=%ss threshold=%s grace=%ss\n' \
        "$display_cycles" "$interval" "$threshold" "$grace"
    sample_no=1
    while { [ "$cycles" -eq 0 ] || [ "$sample_no" -le "$cycles" ]; } &&
          [ "$stopped" -eq 0 ]; do
        if ! watch_monitor_now; then
            if [ "$changes_only" = "0" ] || [ "$last_phase" != UNKNOWN ]; then
                printf 'MONITOR sample=%s/%s state=UNKNOWN phase=UNKNOWN reason=uptime_unavailable\n' \
                    "$sample_no" "$display_cycles"
            fi
            last_phase=UNKNOWN
            last_state=UNKNOWN
            maintenance_since=""
            armed_identity=""
            control_identity=""
            control_attempts=0
            last_identity=""
            last_bus=""
            missing_active=0
            streak=0
            streak_kind=""
            sample_no=$((sample_no + 1))
            { [ "$cycles" -eq 0 ] || [ "$sample_no" -le "$cycles" ]; } &&
                [ "$interval" -gt 0 ] && sleep "$interval"
            continue
        fi
        now=$WATCH_MONITOR_NOW
        control_probe=0
        if [ -z "$control_identity" ] && [ "$control_attempts" -lt 5 ]; then
            control_probe=1
        fi
        # B4.2: every resident sample uses the isolated bounded wrapper.
        # Its child retains the fixture override and read-only arguments.
        sample_output=$(PODKOP_GUARD_WATCH_CONTROL_PROBE="$control_probe" \
            PODKOP_GUARD_WATCH_LOOPBACK_BASELINE_ID="$control_identity" \
            sh "$0" watchdog-check-bounded "$max_sample" 2>&1)
        sample_rc=$?
        late_probe=0
        if watch_monitor_now; then
            sample_elapsed=$((WATCH_MONITOR_NOW - now))
            if [ "$sample_elapsed" -lt 0 ] || [ "$sample_elapsed" -gt "$max_sample" ]; then
                late_probe=1
            fi
        else
            late_probe=1
        fi
        state=UNKNOWN
        pid=none
        birth=
        bus=
        identity=
        command_id=
        config_id=
        case "$sample_output" in
            'WATCHDOG state='*)
                payload=${sample_output#WATCHDOG state=}
                state=${payload%% *}
                case " $sample_output " in
                    *' pid='*)
                        rest=${sample_output#* pid=}
                        pid=${rest%% *}
                        ;;
                esac
                ;;
        esac
        case "$state:$sample_rc" in
            HEALTHY_SAMPLED:0|INACTIVE:0|TRANSITION:0|SUSPECT_DNS_TIMEOUT:1|SUSPECT_PROCESS_MISSING:1|UNKNOWN:2) ;;
            *) state=UNKNOWN ;;
        esac
        case "$state" in
            HEALTHY_SAMPLED|SUSPECT_DNS_TIMEOUT|SUSPECT_PROCESS_MISSING)
                case " $sample_output " in *' bus='*) rest=${sample_output#* bus=}; bus=${rest%% *} ;; esac
                if ! watch_valid_bus_identity "$bus"; then state=UNKNOWN; fi ;;
        esac
        case "$state" in
            HEALTHY_SAMPLED|SUSPECT_DNS_TIMEOUT)
                case " $sample_output " in *' birth='*) rest=${sample_output#* birth=}; birth=${rest%% *} ;; esac
                case " $sample_output " in *' command_id='*) rest=${sample_output#* command_id=}; command_id=${rest%% *} ;; esac
                case " $sample_output " in *' config_id='*) rest=${sample_output#* config_id=}; config_id=${rest%% *} ;; esac
                if watch_monitor_number "$pid" && watch_monitor_number "$birth" &&
                   watch_valid_command_id "$command_id" && watch_valid_command_id "$config_id"; then
                    identity="$pid:$birth:$bus:$command_id:$config_id"
                else state=UNKNOWN
                fi ;;
        esac
        sample_reason=""
        case "$sample_output" in
            *' reason='*)
                rest=${sample_output#* reason=}
                sample_reason=${rest%% *}
                case "$sample_reason" in
                    conntrack_pressure|conntrack_unverified|loopback_unresponsive|procd_unavailable|procd_invalid_reply|procd_stopped|procd_unregistered|procd_registration_changed|unsupported_dns_config|dns_config_path_unavailable|dns_config_path_mismatch|dns_config_file_unavailable|dns_config_identity_unavailable|dns_config_changed|nft_table_absent|nft_table_unavailable|nft_structure_partial|nft_structure_unsupported|nft_rules_incomplete|procd_returned|procd_pid_changed|runtime_identity_unavailable|runtime_identity_changed|ubusd_identity_unavailable|ubusd_changed|list_update|podkop_lifecycle|probe_hard_deadline|probe_late|probe_invalid_exit|probe_empty_output|probe_oversize_output|probe_pid_invalid|probe_isolation_unavailable|probe_isolation_unverified|probe_start_unverified|probe_context_unverified|probe_tmp_unavailable|probe_uncontained|probe_blocked|probe_barrier_unavailable) ;;
                    *) sample_reason="" ;;
                esac ;;
        esac
        if [ "$late_probe" -eq 1 ]; then
            case "$sample_reason" in
                probe_hard_deadline|probe_uncontained|probe_blocked|probe_barrier_unavailable) ;;
                *) sample_reason=probe_late ;;
            esac
        fi
        if [ "$late_probe" -eq 1 ]; then
            # A delayed probe can be CPU starvation, not a sing-box hang.
            state=UNKNOWN
            pid=none
        fi

        # A prolonged observed maintenance window is uncertainty, not
        # permission to interfere. Retain the same suppression/grace.
        case "$state:$sample_reason" in
            TRANSITION:list_update|TRANSITION:podkop_lifecycle)
                if [ -z "$maintenance_since" ] || [ "$now" -lt "$maintenance_since" ]; then
                    maintenance_since=$now
                fi
                if [ "$((now - maintenance_since))" -ge "$maintenance_max" ]; then
                    state=UNKNOWN
                    sample_reason=maintenance_prolonged
                fi ;;
            *) maintenance_since="" ;;
        esac

        # Only compare identities of valid samples. A bus replacement also
        # invalidates a missing-process streak, even without a sing-box PID.
        case "$state" in
            HEALTHY_SAMPLED|SUSPECT_DNS_TIMEOUT|SUSPECT_PROCESS_MISSING)
                if { [ -n "$last_bus" ] && [ "$last_bus" != "$bus" ]; } ||
                   { [ -n "$identity" ] && [ -n "$last_identity" ] && [ "$last_identity" != "$identity" ]; }; then
                    armed_identity=""
                    control_identity=""
                    control_attempts=0
                    missing_active=0
                    hold_until=$((now + grace))
                    streak=0
                    streak_kind=""
                fi
                last_bus=$bus
                last_identity=$identity ;;
            *) last_bus=""; last_identity="" ;;
        esac

        phase=UNKNOWN
        case "$state" in
            HEALTHY_SAMPLED)
                armed_identity=$identity
                if [ "$control_probe" -eq 1 ]; then
                    case "$sample_output" in
                        *' loopback=ok'*) control_identity=$identity ;;
                        *) control_attempts=$((control_attempts + 1)) ;;
                    esac
                fi
                missing_active=0
                streak=0
                streak_kind=""
                phase=HEALTHY
                ;;
            INACTIVE)
                armed_identity=""
                control_identity=""
                control_attempts=0
                last_identity=""
                missing_active=0
                streak=0
                streak_kind=""
                phase=INACTIVE
                ;;
            TRANSITION)
                armed_identity=""
                control_identity=""
                control_attempts=0
                missing_active=0
                streak=0
                streak_kind=""
                hold_until=$((now + grace))
                phase=TRANSITION
                ;;
            UNKNOWN)
                # A sampling gap may hide a restart, even if the next
                # observed numeric PID is unchanged. Require a fresh
                # healthy baseline and loopback control after uncertainty.
                armed_identity=""
                control_identity=""
                control_attempts=0
                last_identity=""
                case "$sample_reason" in
                    procd_unavailable|procd_invalid_reply|procd_stopped|procd_unregistered|ubusd_identity_unavailable|runtime_identity_unavailable|maintenance_prolonged)
                        hold_until=$((now + grace)) ;;
                esac
                missing_active=0
                streak=0
                streak_kind=""
                phase=UNKNOWN
                ;;
            SUSPECT_PROCESS_MISSING|SUSPECT_DNS_TIMEOUT)
                if [ "$state" = SUSPECT_PROCESS_MISSING ]; then
                    # Loss of the registered process invalidates even a
                    # previously healthy DNS baseline for the same PID.
                    armed_identity=""
                    control_identity=""
                    control_attempts=0
                    last_identity=""
                    if [ "$missing_active" -eq 0 ]; then
                        hold_until=$((now + grace))
                        missing_active=1
                    fi
                else
                    missing_active=0
                fi
                if [ "$now" -lt "$startup_deadline" ] && [ -z "$armed_identity" ]; then
                    streak=0
                    streak_kind=""
                    phase=STARTUP_GRACE
                elif [ "$now" -lt "$hold_until" ]; then
                    streak=0
                    streak_kind=""
                    phase=TRANSITION_GRACE
                elif [ "$state" = SUSPECT_DNS_TIMEOUT ] && [ "$armed_identity" != "$identity" ]; then
                    streak=0
                    streak_kind=""
                    phase=WAITING_FOR_BASELINE
                else
                    if [ "$streak_kind" != "$state" ]; then
                        streak=0
                        streak_kind=$state
                    fi
                    streak=$((streak + 1))
                    if [ "$streak" -ge "$threshold" ]; then
                        phase=CONFIRMED
                        if [ "$streak" -eq "$threshold" ]; then
                            confirmations=$((confirmations + 1))
                            printf 'MONITOR_EVENT confirmed=%s state=%s pid=%s samples=%s action=none\n' \
                                "$confirmations" "$state" "$pid" "$streak"
                        fi
                    else
                        phase=SUSPECT
                    fi
                fi
                ;;
        esac
        if [ "$changes_only" = "0" ] || [ "$phase" != "$last_phase" ] || [ "$state" != "$last_state" ]; then
            printf 'MONITOR sample=%s/%s state=%s phase=%s pid=%s streak=%s%s\n' \
                "$sample_no" "$display_cycles" "$state" "$phase" "$pid" "$streak" \
                "$( [ -n "$sample_reason" ] && printf ' reason=%s' "$sample_reason" )"
        fi
        last_phase=$phase
        last_state=$state
        if { [ "$cycles" -eq 0 ] || [ "$sample_no" -lt "$cycles" ]; } && [ "$interval" -gt 0 ]; then
            sleep "$interval"
        fi
        sample_no=$((sample_no + 1))
    done
    trap - TERM INT
    printf 'MONITOR_END completed=%s confirmations=%s action=none\n' \
        "$((sample_no - 1))" "$confirmations"
    return 0
}

# Continuous observe-only process intended for an opt-in procd instance.
# Limited RAM state, no filesystem writes and change-only syslog output.
watchdog_observe() {
    local interval max_sample
    interval="${PODKOP_GUARD_WATCH_INTERVAL:-20}"
    watch_monitor_number "$interval" && [ "$interval" -ge 5 ] && [ "$interval" -le 300 ] || {
        err "continuous observer interval must be 5..300 seconds"
        return 2
    }
    # procd term_timeout=30s; reject longer resident deadlines.
    max_sample="${PODKOP_GUARD_WATCH_MAX_SAMPLE:-8}"
    watch_monitor_number "$max_sample" && [ "$max_sample" -ge 3 ] && [ "$max_sample" -le 20 ] || {
        err "continuous observer deadline must be 3..20 seconds"
        return 2
    }
    PODKOP_GUARD_WATCH_UNBOUNDED=1
    PODKOP_GUARD_WATCH_CHANGES_ONLY=1
    export PODKOP_GUARD_WATCH_UNBOUNDED PODKOP_GUARD_WATCH_CHANGES_ONLY
    watchdog_monitor 0 "$interval"
}

# Stage B1: procd event decoder and one-shot reconciliation.  Both functions
# are READ-ONLY. Events are only observations, never restart authorizations.
# Input is a single line from 'ubus -S subscribe service' (or a mock fixture).
# A missed event is not proof that no crash occurred: procd status is separate.
watchdog_procd_event() {
    local event decoded
    [ "$#" -eq 0 ] || { err "usage: watchdog-procd-event < one-ubus-json-line"; return 2; }
    IFS= read -r event || [ -n "$event" ] || {
        printf 'PROCD_EVENT state=UNKNOWN reason=empty_input action=none\n'
        return 0
    }
    if [ -z "$event" ]; then
        printf 'PROCD_EVENT state=UNKNOWN reason=empty_input action=none\n'
        return 0
    fi
    if [ "${#event}" -gt 8192 ]; then
        printf 'PROCD_EVENT state=UNKNOWN reason=oversize action=none\n'
        return 0
    fi
    if ! command -v jq >/dev/null 2>&1; then
        printf 'PROCD_EVENT state=UNKNOWN reason=jq_unavailable action=none\n'
        return 0
    fi

    decoded=$(printf '%s\n' "$event" | jq -r '
        def integer: (type == "number" and . >= 0 and . == floor);
        if type != "object" then
            "PROCD_EVENT state=UNKNOWN reason=invalid_envelope action=none"
        else
            (if has("instance.fail") then ["FAIL", .["instance.fail"]]
             elif has("instance.respawn") then ["RESPAWN", .["instance.respawn"]]
             elif has("instance.start") then ["START", .["instance.start"]]
             elif has("instance.stop") then ["STOP", .["instance.stop"]]
             else ["OTHER", {}] end) as $e |
            ($e[0]) as $kind | ($e[1]) as $d |
            if $kind == "OTHER" then
                "PROCD_EVENT state=IGNORED reason=other_event action=none"
            elif ($d | type) != "object" then
                "PROCD_EVENT state=UNKNOWN reason=invalid_payload action=none"
            elif $d.service != "sing-box" or $d.instance != "sing-box.main" then
                "PROCD_EVENT state=IGNORED reason=other_instance action=none"
            elif $kind == "START" then
                "PROCD_EVENT state=STARTED source=procd action=none"
            elif $kind == "STOP" then
                "PROCD_EVENT state=STOPPED source=procd reason=undetermined action=none"
            # Stock procd emits only service/instance. Recognize this
            # exact shape without inventing exit metadata. Partial rich
            # payloads still have to pass the existing strict checks.
            elif ($d | keys) == ["instance","service"] then
                (if $kind == "RESPAWN" then "RESPAWN_REPORTED" else "CRASH_LOOP_REPORTED" end) as $state |
                "PROCD_EVENT state=\($state) source=procd detail=notification_only action=none"
            elif (($d.pid | integer) | not) or (($d.exit_code | integer) | not) or
                 (($d.respawn_count | integer) | not) or ($d.pid < 1) or
                 (($d.command | type) != "array") or
                 ($d.command[0] != "/usr/bin/sing-box") then
                "PROCD_EVENT state=UNKNOWN reason=invalid_exit_fields action=none"
            elif $kind == "RESPAWN" then
                "PROCD_EVENT state=RESPAWN_REPORTED source=procd pid=\($d.pid) exit_code=\($d.exit_code) respawn_count=\($d.respawn_count) action=none"
            else
                "PROCD_EVENT state=CRASH_LOOP_REPORTED source=procd pid=\($d.pid) exit_code=\($d.exit_code) respawn_count=\($d.respawn_count) action=none"
            end
        end
    ' 2>/dev/null) || decoded='PROCD_EVENT state=UNKNOWN reason=invalid_json action=none'
    # The output is a fixed enum and validated integers: never echo event data
    # or foreign command lines into the Guard log.
    printf '%s\n' "$decoded"
}

# Shared schema parser: RUNNING is a procd report, not proof of liveness.
watch_procd_report() {
    local raw parsed
    raw=$(ubus -t 5 call service list '{"name":"sing-box"}' 2>/dev/null) || {
        printf 'PROCD_SNAPSHOT state=UNKNOWN reason=ubus_unavailable action=none\n'
        return 0
    }
    if [ -z "$raw" ]; then
        printf 'PROCD_SNAPSHOT state=UNKNOWN reason=empty_reply action=none\n'
        return 0
    fi
    parsed=$(printf '%s\n' "$raw" | jq -rs '
        def unknown($r): "PROCD_SNAPSHOT state=UNKNOWN reason=\($r) action=none";
        def absent: "PROCD_SNAPSHOT state=UNREGISTERED reason=not_listed action=none";
        def integer: if type == "number" then . == floor else false end;
        def supported_command:
            type == "array" and .[0] == "/usr/bin/sing-box" and .[1] == "run" and
            all(.[]; if type == "string" then (explode | all(. >= 32 and . <= 126)) else false end) and
            ((join("\u0000") + "\u0000") | length <= 8192);
        def argv_hex:
            "0123456789abcdef" as $digits |
            (join("\u0000") + "\u0000" | explode |
            map(. as $n | $digits[($n / 16 | floor):(($n / 16 | floor) + 1)] +
                $digits[($n % 16):(($n % 16) + 1)]) | join(""));
        if length != 1 then unknown("invalid_reply")
        else .[0] |
            if type != "object" then unknown("invalid_reply")
            elif (keys - ["sing-box"] | length) != 0 then unknown("invalid_reply")
            elif (has("sing-box") | not) then absent
            elif (.["sing-box"] | type) != "object" then unknown("invalid_service")
            else .["sing-box"] |
                if (has("instances") | not) then absent
                elif (.instances | type) != "object" then unknown("invalid_instances")
                elif (.instances | has("sing-box.main") | not) then absent
                elif (.instances["sing-box.main"] | type) != "object" then unknown("invalid_instance")
                else .instances["sing-box.main"] as $i |
                    if ($i.command | type) != "array" or
                       ($i.command[0] != "/usr/bin/sing-box") then unknown("wrong_command")
                    elif $i.running == true then
                        if ($i.pid | integer) and $i.pid > 1 and $i.pid <= 2147483647 then
                            if ($i.command | supported_command) then
                                "PROCD_SNAPSHOT state=RUNNING pid=\($i.pid) argv=\($i.command | argv_hex) action=none"
                            else unknown("wrong_command") end
                        else unknown("incomplete_instance") end
                    elif $i.running == false then
                        if ($i | has("pid")) then unknown("incomplete_instance")
                        elif ($i.command | supported_command | not) then
                            unknown("wrong_command")
                        elif ($i.exit_code | integer) and $i.exit_code >= 0 then
                            "PROCD_SNAPSHOT state=STOPPED exit_code=\($i.exit_code) reason=undetermined action=none"
                        else
                            "PROCD_SNAPSHOT state=STOPPED exit_code=unknown reason=undetermined action=none"
                        end
                    else unknown("incomplete_instance") end
                end
            end
        end
    ' 2>/dev/null) || parsed='PROCD_SNAPSHOT state=UNKNOWN reason=invalid_json action=none'
    printf '%s\n' "$parsed"
}

watchdog_procd_snapshot() {
    local tool report root pid rest argv birth bus
    [ "$#" -eq 0 ] || { err "usage: watchdog-procd-snapshot"; return 2; }
    for tool in ubus jq hexdump readlink; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            printf 'PROCD_SNAPSHOT state=UNKNOWN reason=missing_tool action=none\n'
            return 0
        fi
    done
    bus=
    if watch_runtime_bus; then bus=$WATCH_PROCD_BUS_ID; fi
    report=$(watch_procd_report)
    case "$report" in
        'PROCD_SNAPSHOT state=RUNNING pid='*' argv='*' action=none')
            rest=${report#* pid=}; pid=${rest%% *}
            rest=${report#* argv=}; argv=${rest%% *}
            root="${PODKOP_GUARD_WATCH_PROC_ROOT:-/proc}"
            if [ -z "$bus" ]; then
                printf 'PROCD_SNAPSHOT state=UNKNOWN reason=ubusd_identity_unavailable action=none\n'
            elif ! birth=$(watch_process_birth "$root" "$pid") ||
                 ! watch_runtime_matches "$root" "$pid" "$birth" "$argv"; then
                printf 'PROCD_SNAPSHOT state=UNKNOWN reason=runtime_identity_unavailable action=none\n'
            elif [ "$(watch_procd_report)" != "$report" ]; then
                printf 'PROCD_SNAPSHOT state=UNKNOWN reason=runtime_identity_changed action=none\n'
            elif ! watch_runtime_matches "$root" "$pid" "$birth" "$argv"; then
                printf 'PROCD_SNAPSHOT state=UNKNOWN reason=runtime_identity_unavailable action=none\n'
            elif ! watch_runtime_bus || [ "$WATCH_PROCD_BUS_ID" != "$bus" ]; then
                printf 'PROCD_SNAPSHOT state=UNKNOWN reason=ubusd_identity_changed action=none\n'
            else
                printf 'PROCD_SNAPSHOT state=RUNNING pid=%s action=none\n' "$pid"
            fi ;;
        *) printf '%s\n' "$report" ;;
    esac
}

# Stage B2: procd event stream + independent snapshot reconciliation.
# Manual CLI only; NEVER triggers service, UCI, network, or recovery changes.
# The event stream has no replay: history is INCOMPLETE after any reconnect.
watchdog_procd_bus_identity() {
    local id pids pid start
    if [ -n "${PODKOP_GUARD_PROCD_BUS_FILE:-}" ]; then
        [ -r "$PODKOP_GUARD_PROCD_BUS_FILE" ] || return 1
        IFS= read -r id < "$PODKOP_GUARD_PROCD_BUS_FILE" || [ -n "$id" ] || return 1
        case "$id" in ''|DOWN|*[!a-zA-Z0-9_.:-]*) return 1 ;; esac
        WATCH_PROCD_BUS_ID=$id
        return 0
    fi
    command -v pidof >/dev/null 2>&1 || return 1
    pids=$(pidof ubusd 2>/dev/null) || return 1
    set -- $pids
    [ "$#" -eq 1 ] || return 1
    pid="$1"
    start=$(watch_process_birth /proc "$pid") || return 1
    WATCH_PROCD_BUS_ID="$pid:$start"
}

watchdog_procd_stop_subscriber() {
    if [ -n "$WATCH_PROCD_SUB_PID" ]; then
        kill -TERM "$WATCH_PROCD_SUB_PID" 2>/dev/null || :
        kill -KILL "$WATCH_PROCD_SUB_PID" 2>/dev/null || :
        wait "$WATCH_PROCD_SUB_PID" 2>/dev/null || :
        WATCH_PROCD_SUB_PID=
    fi
}

watchdog_procd_cleanup() {
    watchdog_procd_stop_subscriber
    exec 3>&-
    if [ -n "$WATCH_PROCD_DIR" ]; then
        rm -f "$WATCH_PROCD_DIR/events"
        rmdir "$WATCH_PROCD_DIR" 2>/dev/null || :
    fi
    WATCH_PROCD_DIR=
}

watchdog_procd_reset_fifo() {
    exec 3>&-
    rm -f "$WATCH_PROCD_DIR/events"
    mkfifo "$WATCH_PROCD_DIR/events" || return 1
    exec 3<>"$WATCH_PROCD_DIR/events" || return 1
    rm -f "$WATCH_PROCD_DIR/events"
}

watchdog_procd_subscriber_alive() {
    [ -n "$WATCH_PROCD_SUB_PID" ] || return 1
    kill -0 "$WATCH_PROCD_SUB_PID" 2>/dev/null || return 1
    if [ -r "/proc/$WATCH_PROCD_SUB_PID/status" ] &&
        grep -q '^State:[[:space:]]*Z' "/proc/$WATCH_PROCD_SUB_PID/status"; then
        return 1
    fi
}

watchdog_procd_monitor() {
    local cycles interval changes_only sample bus_id old_bus sub_state
    local event decoded event_state diagnosis snap snapshot pid old_snapshot
    local resets attempts last_view view reason seen_event
    [ "$#" -le 2 ] || { err "usage: watchdog-procd-monitor [cycles] [interval]"; return 2; }
    cycles="${1:-6}"
    interval="${2:-5}"
    watch_monitor_number "$cycles" && watch_monitor_number "$interval" || return 2
    [ "$cycles" -ge 1 ] && [ "$cycles" -le 30 ] || return 2
    [ "$interval" -ge 1 ] && [ "$interval" -le 30 ] || return 2
    changes_only="${PODKOP_GUARD_PROCD_CHANGES_ONLY:-0}"
    case "$changes_only" in 0|1) ;; *) return 2 ;; esac
    for tool in ubus jq mktemp mkfifo pidof awk; do
        command -v "$tool" >/dev/null 2>&1 || { err "missing procd monitor tool: $tool"; return 2; }
    done
    WATCH_PROCD_DIR=$(mktemp -d "${PODKOP_GUARD_PROCD_TMP_DIR:-/tmp}/podkop-guard-procd.XXXXXX") || return 2
    WATCH_PROCD_SUB_PID=
    WATCH_PROCD_STOP=0
    trap 'WATCH_PROCD_STOP=1' TERM INT
    trap 'watchdog_procd_cleanup' EXIT
    watchdog_procd_reset_fifo || return 2
    sample=0
    attempts=0
    resets=0
    old_bus=
    old_snapshot=
    last_view=
    seen_event=0
    printf 'PROCD_MONITOR mode=bounded cycles=%s interval=%ss history=INCOMPLETE action=none\n' "$cycles" "$interval"
    while [ "$WATCH_PROCD_STOP" -eq 0 ] && [ "$sample" -lt "$cycles" ]; do
        sample=$((sample + 1))
        bus_id=
        if watchdog_procd_bus_identity; then bus_id=$WATCH_PROCD_BUS_ID; fi
        sub_state=UNKNOWN
        if [ -z "$bus_id" ]; then
            if [ -n "$WATCH_PROCD_SUB_PID" ]; then
                printf 'PROCD_MONITOR_EVENT subscription=LOST reason=ubusd_unavailable history=INCOMPLETE action=none\n'
                watchdog_procd_stop_subscriber
                old_bus=
                resets=$((resets + 1))
            fi
            sleep "$interval"
        else
            if [ "$bus_id" != "$old_bus" ] || ! watchdog_procd_subscriber_alive; then
                if [ -n "$WATCH_PROCD_SUB_PID" ]; then
                    reason=ubusd_changed
                    [ "$bus_id" = "$old_bus" ] && reason=subscriber_exit
                    printf 'PROCD_MONITOR_EVENT subscription=RESET reason=%s history=INCOMPLETE action=none\n' "$reason"
                    watchdog_procd_stop_subscriber
                    resets=$((resets + 1))
                fi
                watchdog_procd_reset_fifo || break
                ubus -S subscribe service >&3 2>/dev/null &
                WATCH_PROCD_SUB_PID=$!
                old_bus=$bus_id
                attempts=$((attempts + 1))
                printf 'PROCD_MONITOR_EVENT subscription=ATTEMPT number=%s history=INCOMPLETE action=none\n' "$attempts"
            fi
            sub_state=SUBSCRIBED_UNVERIFIED
            event=
            if IFS= read -r -t "$interval" event <&3; then
                decoded=$(printf '%s\n' "$event" | watchdog_procd_event)
                case "$decoded" in
                    'PROCD_EVENT state=IGNORED '*) ;;
                    *)
                        event_state=${decoded#PROCD_EVENT state=}
                        event_state=${event_state%% *}
                        diagnosis=UNCONFIRMED
                        if [ "$event_state" = CRASH_LOOP_REPORTED ] ||
                            [ "$event_state" = RESPAWN_REPORTED ]; then
                            if watch_maintenance_active; then diagnosis=MAINTENANCE; fi
                        fi
                        printf 'PROCD_MONITOR_EVENT event=%s diagnosis=%s history=INCOMPLETE action=none\n' "$event_state" "$diagnosis"
                        seen_event=1
                        ;;
                esac
            fi
        fi
        snapshot=$(watchdog_procd_snapshot)
        snap=${snapshot#PROCD_SNAPSHOT state=}
        snap=${snap%% *}
        pid=none
        case "$snapshot" in *' pid='*) pid=${snapshot#* pid=}; pid=${pid%% *} ;; esac
        if [ -n "$old_snapshot" ] && [ "$old_snapshot" != "$snapshot" ] &&
            [ "$seen_event" -eq 0 ]; then
            printf 'PROCD_MONITOR_EVENT state_change=UNEXPLAINED snapshot=%s history=INCOMPLETE action=none\n' "$snap"
        fi
        old_snapshot=$snapshot
        seen_event=0
        view="$sub_state:$snap:$pid"
        if [ "$changes_only" = 0 ] || [ "$view" != "$last_view" ]; then
            printf 'PROCD_MONITOR sample=%s subscription=%s snapshot=%s pid=%s history=INCOMPLETE action=none\n' "$sample" "$sub_state" "$snap" "$pid"
        fi
        last_view=$view
    done
    trap - TERM INT EXIT
    watchdog_procd_cleanup
    printf 'PROCD_MONITOR_END completed=%s attempts=%s resets=%s action=none\n' "$sample" "$attempts" "$resets"
}

usage() {
    cat <<'EOF'
Usage: podkop-guard <command>

Commands:
  status          Show current guard/LKG state
  verify-lkg      Inspect the persistent LKG SRS
  derive-subnets  Rebuild Local Subnet LKG from persistent lkg.srs
  refresh-test    Build and fully validate new candidates without saving them
  refresh         Build, validate and atomically commit a new persistent LKG
  cache-restore   Manually restore cache while sing-box is stopped
  boot-restore    Safe boot-time cache restore (skips when not applicable)
  watchdog-check  One-shot isolated observe-only local probe (default 8s)
  watchdog-check-bounded [seconds]  Isolated local probe with deadline (B4)
  watchdog-monitor [cycles] [interval]  Bounded RAM-only observer (default 6 x 20s)
  watchdog-observe  Continuous observe-only monitor (opt-in procd instance)
  watchdog-procd-event  Decode a single procd event from stdin (no action)
  watchdog-procd-snapshot  Read current sing-box.main procd state (no action)
  watchdog-procd-monitor [cycles] [interval]  Bounded procd subscription and reconciliation
  daemon          Run the periodic validated refresh worker
  version         Print version

The periodic worker checks once per hour and refreshes no more than once per
24 hours after a successful snapshot. Failed refreshes never replace the
current persistent LKG and are retried on the next hourly check.
EOF
}

case "${1:-}" in
    status) status ;;
    verify-lkg) verify_lkg ;;
    derive-subnets) derive_subnets ;;
    refresh-test) refresh_snapshot 0 ;;
    refresh) refresh_snapshot 1 ;;
    cache-restore) cache_restore ;;
    boot-restore) boot_restore ;;
    watchdog-check) shift; [ "$#" -eq 0 ] || exit 2; watchdog_check_bounded ;;
    watchdog-check-internal) shift; watchdog_check_internal "$@" ;;
    watchdog-check-bounded) shift; watchdog_check_bounded "$@" ;;
    watchdog-monitor) shift; watchdog_monitor "$@" ;;
    watchdog-observe) watchdog_observe ;;
    watchdog-procd-event) shift; watchdog_procd_event "$@" ;;
    watchdog-procd-snapshot) shift; watchdog_procd_snapshot "$@" ;;
    watchdog-procd-monitor) shift; watchdog_procd_monitor "$@" ;;
    daemon) daemon_loop ;;
    version|--version|-V) echo "$VERSION" ;;
    help|--help|-h|'') usage ;;
    *) err "unknown command: $1"; usage >&2; exit 2 ;;
esac
