#!/bin/sh /etc/rc.common

# Restore the persistent sing-box cache immediately before Podkop (START=99),
# then keep a very lightweight validated LKG refresh worker under procd.

START=98
STOP=01
USE_PROCD=1

PROG="/usr/bin/podkop-guard"

start_service() {
    # Boot restore is intentionally best-effort: a missing snapshot must not
    # block the rest of OpenWrt boot. podkop-guard logs the exact reason.
    PODKOP_GUARD_SYSLOG=1 "$PROG" boot-restore || \
        logger -t podkop-guard "warning: boot cache restore returned an error"

    procd_open_instance
    procd_set_param command "$PROG" daemon
    procd_set_param respawn 3600 5 5

    # The daemon sleeps in chunks of at most 60 seconds. This gives it enough
    # time to receive SIGTERM, finish the current short child process and clean
    # its /tmp lock/work directory without making service stop unbounded.
    procd_set_param term_timeout 70
    procd_close_instance
}

reload_service() {
    stop
    start
}
